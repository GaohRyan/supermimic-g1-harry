+def anchor_ori_window_obs(robot_anchor_quat: torch.Tensor, ref_quat_window: torch.Tensor) -> torch.Tensor:
+    """Reference root orientation at each window frame, relative to the robot anchor: (N, K*6) rot6d.
+    Official release: actor goal = [joint targets, rel_ori]; rel_pos goes to the world model only."""
+    from supermimic.kinematics.rotations import matrix_from_quat, quat_inv, quat_mul
+
+    k = ref_quat_window.shape[-2]
+    q10 = quat_inv(robot_anchor_quat)[..., None, :].expand(*ref_quat_window.shape)
+    mat = matrix_from_quat(quat_mul(q10, ref_quat_window))
+    return mat[..., :2].reshape(*ref_quat_window.shape[:-2], k * 6)
+
