diff --git a/src/supermimic/envs/mdp/motion_library.py b/src/supermimic/envs/mdp/motion_library.py
index 48cbfdd..52760cc 100644
--- a/src/supermimic/envs/mdp/motion_library.py
+++ b/src/supermimic/envs/mdp/motion_library.py
@@ -233,6 +233,28 @@ class MotionLibrary:
         feat = goal_features(self.ref(idx.reshape(-1)), self.default_joint_pos)
         return feat.reshape(frame.shape[0], k * GOAL_FEAT_DIM)
 
+    # ---- goal layout of the official release (HybridRobotics/supermimic @ 5efbf11, representations.py):
+    # 10 reference frames spaced 5 control steps apart (~0.9 s lookahead), clamped at the clip end; per frame
+    # [joint_pos (29), joint_vel (29)]; plus the reference root orientation at the same frames.
+    OFFICIAL_FRAMES = 10
+    OFFICIAL_STRIDE = 5
+
+    def official_window_idx(self, frame: torch.Tensor) -> torch.Tensor:
+        last = self.last_frame_of(frame)
+        offs = torch.arange(self.OFFICIAL_FRAMES, device=self.device) * self.OFFICIAL_STRIDE
+        return torch.minimum(frame[:, None] + offs[None, :], last[:, None])  # (N, 10)
+
+    def goal_window_official(self, frame: torch.Tensor) -> torch.Tensor:
+        """(N, 10*58) joint targets of the strided future window."""
+        idx = self.official_window_idx(frame)
+        r = self.ref(idx.reshape(-1))
+        return torch.cat([r.joint_pos, r.joint_vel], dim=-1).reshape(frame.shape[0], -1)
+
+    def root_quat_window_official(self, frame: torch.Tensor) -> torch.Tensor:
+        """(N, 10, 4) reference root (pelvis) orientation at the strided window frames."""
+        idx = self.official_window_idx(frame)
+        return self.ref(idx.reshape(-1)).root_quat_w.reshape(frame.shape[0], self.OFFICIAL_FRAMES, 4)
+
     def ref_qpos_qvel(self, frame: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
         """MuJoCo-layout reference state: qpos (N,36) and qvel (N,35; root ang vel in body frame)."""
         r = self.ref(frame)
