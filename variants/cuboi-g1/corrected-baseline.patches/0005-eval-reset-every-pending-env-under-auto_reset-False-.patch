From 3668b7adc7b13cfa51991385134b365e253ad6e9 Mon Sep 17 00:00:00 2001
From: Hang(Harry) Gao <GaohRyan@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:41:07 -0500
Subject: [PATCH 5/6] eval: reset every pending env under auto_reset=False;
 test: real-mjlab import order

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/eval_fullclip_traj.py | 6 +++++-
 tests/test_done_labels.py     | 1 +
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/scripts/eval_fullclip_traj.py b/scripts/eval_fullclip_traj.py
index 55c5701..dca6c3d 100644
--- a/scripts/eval_fullclip_traj.py
+++ b/scripts/eval_fullclip_traj.py
@@ -152,6 +152,7 @@ def main(ckpt: Path, out: Path, clips: list[str] | None = None, npz_dir: Path =
             S.append(io.read().cpu().numpy())  # s_{t+1}; for done envs this is the pre-reset terminal state
             REF.append(lib.ref_qpos_qvel(cmd.frame)[0].cpu().numpy())  # reference at the same (pre-reset) frame
             FR.append(cmd.frame.cpu().numpy())
+            pending = env.reset_buf.clone()  # every env that terminated/timed out this step (alive or already finished)
             done = (term | tout) & alive
             if done.any():
                 ids = done.nonzero().squeeze(-1)
@@ -160,7 +161,10 @@ def main(ckpt: Path, out: Path, clips: list[str] | None = None, npz_dir: Path =
                     reason[e] = "+".join(fired) if fired else "unknown"
                     term_steps[e] = int(steps[e])
                 alive &= ~done
-                env.reset(env_ids=ids)  # required by mjlab when auto_reset=False; env ignored afterwards
+            if pending.any():
+                # mjlab requires an explicit reset of every done env when auto_reset=False; finished envs keep
+                # replaying their clip as filler and are ignored (alive=False) for all statistics.
+                env.reset(env_ids=pending.nonzero().squeeze(-1))
             if int(steps.max()) >= max_steps:
                 for e in alive.nonzero().squeeze(-1).tolist():
                     reason[e] = "eval_step_cap"
diff --git a/tests/test_done_labels.py b/tests/test_done_labels.py
index 62af17e..3c0625d 100644
--- a/tests/test_done_labels.py
+++ b/tests/test_done_labels.py
@@ -20,6 +20,7 @@ import torch
 def _stub_mjlab():
     try:
         import mjlab.managers.recorder_manager  # noqa: F401  real mjlab available (GPU image)
+        import supermimic.envs  # noqa: F401  import order of real use (envs -> recorder) avoids a circular import
         return
     except ImportError:
         pass
