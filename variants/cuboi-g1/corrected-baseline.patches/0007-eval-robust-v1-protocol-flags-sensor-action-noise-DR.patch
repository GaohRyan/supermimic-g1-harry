index 0000000..6f7c76e
--- /dev/null
+++ b/scripts/export_sim2sim_contract.py
@@ -0,0 +1,73 @@
+"""Export what a second simulator needs to run this policy closed loop (sim2sim, PIPELINE §7).
+
+Writes <out>/g1_nominal.mjb (the compiled host-side MjModel of the nominal env: same MJCF, actuators,
+armature, friction 1.0) and <out>/contract.json (joint / actuator order, action scale and offset,
+default pose, soft limits, timestep, decimation, solver options, tracked bodies).
+
+  uv run python scripts/export_sim2sim_contract.py --npz-dir <npz> --out <dir>
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import mujoco
+import torch
+import tyro
+
+from supermimic.envs.mdp.motion_library import discover_npz
+from supermimic.envs.tracking_env_cfg import ANCHOR_BODY, FOOT_GEOM_REGEX, ROOT_BODY, TRACKED_BODIES, SuperMimicEnvCfgArgs, make_env_cfg
+
+
+def main(npz_dir: Path, out: Path, device: str = "cuda:0") -> None:
+    files = [str(f) for f in discover_npz(npz_dir)][:1]
+    args = SuperMimicEnvCfgArgs(npz_files=files, num_envs=1, future_frames=10, episode_length_s=10.0, action_noise_std=0.0, obs_noise=False,
+                                reset_noise=False, domain_randomization=False, sampling_mode="start", record_transitions=False, seed=0)
+    from mjlab.envs import ManagerBasedRlEnv
+
+    env_cfg = make_env_cfg(args)
+    env = ManagerBasedRlEnv(env_cfg, device=device)
+    try:
+        env.reset()
+        m = env.sim.mj_model
+        robot = env.scene["robot"]
+        act = env.action_manager.get_term("joint_pos")
+        out.mkdir(parents=True, exist_ok=True)
+        mujoco.mj_saveModel(m, str(out / "g1_nominal.mjb"))
+        n = lambda t, i: mujoco.mj_id2name(m, t, i)  # noqa: E731
+        tl = lambda x: x[0].tolist() if torch.is_tensor(x) else float(x)  # noqa: E731
+        ctrl_ids = robot.indexing.ctrl_ids.tolist()
+        joint_ids = robot.indexing.joint_ids.tolist()
+        contract = {
+            "schema_version": 1, "mujoco_version": mujoco.__version__, "nq": m.nq, "nv": m.nv, "nu": m.nu, "nbody": m.nbody,
+            "timestep": float(m.opt.timestep), "decimation": int(env_cfg.decimation), "control_dt": float(m.opt.timestep) * int(env_cfg.decimation),
+            "opt": {"integrator": int(m.opt.integrator), "solver": int(m.opt.solver), "iterations": int(m.opt.iterations), "ls_iterations": int(m.opt.ls_iterations),
+                    "cone": int(m.opt.cone), "impratio": float(m.opt.impratio), "tolerance": float(m.opt.tolerance), "ls_tolerance": float(m.opt.ls_tolerance),
+                    "gravity": list(map(float, m.opt.gravity)), "noslip_iterations": int(m.opt.noslip_iterations)},
+            "robot_joint_names": list(robot.joint_names), "robot_joint_ids_in_model": joint_ids,
+            "model_joint_names": [n(mujoco.mjtObj.mjOBJ_JOINT, i) for i in range(m.njnt)],
+            "actuator_names": [n(mujoco.mjtObj.mjOBJ_ACTUATOR, i) for i in range(m.nu)],
+            "actuator_joint_names": [n(mujoco.mjtObj.mjOBJ_JOINT, int(m.actuator_trnid[i, 0])) for i in range(m.nu)],
+            "robot_ctrl_ids": ctrl_ids,
+            "actuator_gainprm0": [float(m.actuator_gainprm[i, 0]) for i in range(m.nu)],
+            "actuator_biasprm": [[float(x) for x in m.actuator_biasprm[i, :3]] for i in range(m.nu)],
+            "actuator_forcerange": [[float(x) for x in m.actuator_forcerange[i]] for i in range(m.nu)],
+            "actuator_ctrlrange": [[float(x) for x in m.actuator_ctrlrange[i]] for i in range(m.nu)],
+            "action_scale": tl(act._scale), "action_offset": tl(act._offset),
+            "action_joint_names": list(act._target_names),
+            "default_joint_pos": robot.data.default_joint_pos[0].tolist(),
+            "soft_joint_pos_limits": robot.data.soft_joint_pos_limits[0].tolist(),
+            "env_origin": env.scene.env_origins[0].tolist(),
+            "tracked_bodies": list(TRACKED_BODIES), "anchor_body": ANCHOR_BODY, "root_body": ROOT_BODY, "foot_geom_regex": FOOT_GEOM_REGEX,
+            "qpos0": [float(x) for x in m.qpos0], "key_nkey": int(m.nkey),
+            "reward_dt_scale_note": "reward per control step as returned by env.step (max 0.1 = dt * 5.0)",
+        }
+        (out / "contract.json").write_text(json.dumps(contract, indent=1))
+        print(json.dumps({k: contract[k] for k in ("mujoco_version", "nq", "nu", "timestep", "decimation")}))
+    finally:
+        env.close()
+
+
+if __name__ == "__main__":
+    tyro.cli(main)
