 src/supermimic/config.py                |  1 +
 src/supermimic/envs/mdp/commands.py     | 11 ++++++++
 src/supermimic/envs/tracking_env_cfg.py |  2 ++
 src/supermimic/training/loop.py         |  1 +
 tests/test_sampler_clip_end_norm.py     | 35 +++++++++++++++++++++++++
 5 files changed, 50 insertions(+)
 create mode 100644 tests/test_sampler_clip_end_norm.py

