index b219cb3..5d6b86f 100644
--- a/src/supermimic/config.py
+++ b/src/supermimic/config.py
@@ -35,6 +35,7 @@ class EnvCfg:
     anchor_obs: bool = False
     sim2real_dr: bool = False  # optimisation line: extra dynamics randomisation, xi grows to 38-D
     action_delay_max: int = 0  # optimisation line: action delay U{0..N} control steps (env and imagination)
+    sampler_clip_end_norm: bool = False  # optimisation line: reset sampler uses horizon-normalised return-to-go
     goal_contract: str = "cuboi"  # "official" = goal layout + anchor body of the official release (needs anchor_obs_mode ori_window)
     anchor_obs_mode: str = "full"  # with anchor_obs: "full" = position (3) + rot6d (6); "ori" = rot6d (6) only (IMU-observable)
 
diff --git a/src/supermimic/envs/mdp/commands.py b/src/supermimic/envs/mdp/commands.py
index 6dd1eda..a4d3ff6 100644
--- a/src/supermimic/envs/mdp/commands.py
+++ b/src/supermimic/envs/mdp/commands.py
@@ -240,6 +240,15 @@ class MultiClipMotionCommand(CommandTerm):
             else:
                 remaining = lens[:, None] - torch.arange(T, device=self.device)[None, :]
                 tmask = tmask & ~(truncated[:, None] & (remaining < cfg.min_remaining_steps))
+        if cfg.clip_end_norm:
+            # Episodes that end without a failure (clip end or time-out) have a return-to-go that shrinks only because
+            # few steps are left. Rescale it to the full-horizon equivalent so that "little time left" is not read as
+            # "hard"; failed episodes are left as they are. Steps too close to the end are dropped (too noisy).
+            ended_ok = ~terminated
+            remaining = (lens[:, None] - torch.arange(T, device=self.device)[None, :]).clamp_min(0).double()
+            scale = 1.0 / (1.0 - cfg.gamma ** remaining).clamp_min(1e-6)
+            rtg = torch.where(ended_ok[:, None], rtg * scale, rtg)
+            tmask = tmask & ~(ended_ok[:, None] & (remaining < cfg.clip_end_min_steps))
         valid = tmask.reshape(-1)
         b = bins.reshape(-1)[valid]
         g = rtg.reshape(-1)[valid].float()
@@ -427,6 +436,8 @@ class MultiClipMotionCommandCfg(CommandTermCfg):
     ema_alpha: float = 0.05
     memory_alpha: float = 0.01
     min_remaining_steps: int = 100
+    clip_end_norm: bool = False  # optimisation line: horizon-normalised return-to-go for episodes that end without failure
+    clip_end_min_steps: int = 25
     max_logged_steps: int = 1024
     compact_library: bool = False
     library_fp16: bool = True
