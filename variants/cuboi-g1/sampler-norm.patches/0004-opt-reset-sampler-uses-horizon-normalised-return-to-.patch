diff --git a/tests/test_sampler_clip_end_norm.py b/tests/test_sampler_clip_end_norm.py
new file mode 100644
index 0000000..ac18ccd
--- /dev/null
+++ b/tests/test_sampler_clip_end_norm.py
@@ -0,0 +1,35 @@
+"""Reset sampler: horizon-normalised return-to-go (clip_end_norm). Constant reward, episodes ending at the clip end must
+not look harder than mid-clip steps; failed episodes must still look hard. Pure torch (stub env)."""
+import types
+
+import torch
+
+from supermimic.envs.mdp.commands import MultiClipMotionCommand
+
+
+def _run(clip_end_norm: bool, terminated: bool):
+    n, T, nb = 4, 300, 6
+    lib = types.SimpleNamespace(num_bins=nb)
+    cfg = types.SimpleNamespace(gamma=0.99, ema_alpha=1.0, min_remaining_steps=100, clip_end_norm=clip_end_norm, clip_end_min_steps=25)
+    env = types.SimpleNamespace(termination_manager=types.SimpleNamespace(terminated=torch.full((n,), terminated)))
+    me = types.SimpleNamespace(
+        cfg=cfg, library=lib, device="cpu", _env=env, bootstrap_fn=None,
+        ep_len=torch.full((n,), T), ep_rewards=torch.full((n, T), 0.08),
+        ep_bins=(torch.arange(T) // 50).repeat(n, 1), clip_end=torch.ones(n, dtype=torch.bool),
+        _gamma_pow=0.99 ** torch.arange(T, dtype=torch.float64),
+        bin_return=torch.zeros(nb), metrics={"episode_return_to_go": torch.zeros(n)},
+    )
+    MultiClipMotionCommand._finalize_episodes(me, torch.arange(n))
+    return me.bin_return
+
+
+def test_clip_end_no_longer_looks_hard():
+    old = _run(False, False)
+    new = _run(True, False)
+    assert old[-1] < 0.6 * old[0]  # the bias: last bin of the clip looks much harder
+    assert (new.max() - new.min()) / new.mean() < 0.02  # constant reward -> flat after normalisation
+    assert abs(new.mean().item() - 8.0) < 0.2  # 0.08 / (1 - 0.99)
+
+
+def test_failures_keep_low_return():
+    assert torch.allclose(_run(True, True), _run(False, True))
