+def foot_clearance_deficit(foot_pos: torch.Tensor, foot_lin_vel: torch.Tensor, ground_fn, cfg: TrackingRewardCfg) -> torch.Tensor:
+    """sum over the two feet of  speed_xy * max(0, margin - clearance)^2   (N,).
+
+    clearance = sole height - highest terrain point under the foot and up to 15 cm ahead of it along its direction of
+    travel. A foot that approaches a riser is therefore asked to rise before it reaches the edge; a foot that does not
+    move horizontally (stance) costs nothing. The gradient acts on the foot height only: the speed and the terrain
+    lookups are detached, so the term cannot be reduced by slowing the foot down.
+    """
+    v = foot_lin_vel[..., :2].detach()
+    speed = v.norm(dim=-1)  # (N, 2)
+    direction = v / speed.clamp_min(1e-3)[..., None]
+    ahead = torch.as_tensor(cfg.clearance_ahead, dtype=foot_pos.dtype, device=foot_pos.device)  # (K,)
+    pts = foot_pos[..., None, :2].detach() + direction[..., None, :] * ahead[:, None]  # (N, 2, K, 2)
+    n = pts.shape[:-3]
+    h = ground_fn(pts.reshape(*n, 2 * ahead.numel(), 2)).reshape(*n, 2, ahead.numel()).max(dim=-1).values.detach()  # (N, 2)
+    clearance = foot_pos[..., 2] - cfg.clearance_sole_offset - h
+    return (speed * (cfg.clearance_margin - clearance).clamp(min=0.0) ** 2).sum(-1)
