         return self.decoder(z) * SCAN_SCALE + SCAN_OFFSET, z
 
 
+class FrozenScanEncoder(nn.Module):
+    """The pre-trained encoder with its weights held as buffers: it has no parameters, so no optimizer, weight decay or
+    ``requires_grad_`` call can ever change it, and it still travels inside the policy's state dict. Gradients with
+    respect to the input scan pass through."""
+
+    def __init__(self, cfg: ScanAECfg):
+        super().__init__()
+        self.cfg = cfg
+        dims = (cfg.scan_dim, *cfg.hidden, cfg.latent_dim)
+        self.n_layers = len(dims) - 1
+        for i in range(self.n_layers):
+            self.register_buffer(f"w{i}", torch.zeros(dims[i + 1], dims[i]))
+            self.register_buffer(f"b{i}", torch.zeros(dims[i + 1]))
+        self.register_buffer("loaded", torch.zeros((), dtype=torch.bool))
+
+    @torch.no_grad()
+    def load_from(self, encoder: ScanEncoder) -> None:
+        linears = [m for m in encoder.net if isinstance(m, nn.Linear)]
+        assert len(linears) == self.n_layers
+        for i, lin in enumerate(linears):
+            getattr(self, f"w{i}").copy_(lin.weight)
+            getattr(self, f"b{i}").copy_(lin.bias)
+        self.loaded.fill_(True)
+
+    def forward(self, scan: torch.Tensor) -> torch.Tensor:
+        x = (scan - SCAN_OFFSET) / SCAN_SCALE
+        for i in range(self.n_layers):
+            x = torch.nn.functional.linear(x, getattr(self, f"w{i}"), getattr(self, f"b{i}"))
+            if i < self.n_layers - 1:
+                x = torch.nn.functional.elu(x)
+        return x
+
+
 def load_frozen_encoder(path, device="cpu") -> tuple[ScanEncoder, dict]:
     """Encoder of a pre-trained autoencoder, in eval mode with gradients off. Returns (encoder, metadata)."""
     ck = torch.load(path, map_location=device, weights_only=True)
