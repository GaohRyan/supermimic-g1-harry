index 0000000..d296d2f
--- /dev/null
+++ b/src/supermimic/terrain/expand.py
@@ -0,0 +1,41 @@
+"""Load a checkpoint of a network that had fewer inputs into the same network with inputs appended.
+
+The terrain task appends inputs (height scan) to trained flat-ground networks. Appended inputs sit after the existing
+ones, so the old first-layer weights keep their columns and the new columns are set to zero: the extended network
+computes exactly what the old one did, whatever the new inputs are.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+
+
+@torch.no_grad()
+def load_state_dict_expand(module: nn.Module, state: dict, allow_missing_prefixes: tuple[str, ...] = ()) -> dict:
+    """Copy ``state`` into ``module``. A 2-D weight whose input dimension grew is copied into its first columns and
+    the new columns are zeroed. Keys of ``module`` that start with one of ``allow_missing_prefixes`` may be absent
+    from ``state`` (e.g. a newly added frozen encoder). Anything else that does not match raises.
+    Returns {"expanded": {key: (old_in, new_in)}, "missing": [...]}."""
+    own = module.state_dict()
+    expanded, missing = {}, []
+    unexpected = [k for k in state if k not in own]
+    if unexpected:
+        raise KeyError(f"unexpected keys in checkpoint: {unexpected[:5]}")
+    for k, dst in own.items():
+        if k not in state:
+            if k.startswith(allow_missing_prefixes) and allow_missing_prefixes:
+                missing.append(k)
+                continue
+            raise KeyError(f"checkpoint has no {k!r}")
+        src = state[k]
+        if src.shape == dst.shape:
+            dst.copy_(src)
+        elif src.ndim == 2 and dst.ndim == 2 and src.shape[0] == dst.shape[0] and src.shape[1] < dst.shape[1]:
+            dst.zero_()
+            dst[:, : src.shape[1]].copy_(src)
+            expanded[k] = (int(src.shape[1]), int(dst.shape[1]))
+        else:
+            raise ValueError(f"{k}: checkpoint shape {tuple(src.shape)} does not fit {tuple(dst.shape)}")
+    module.load_state_dict(own)
+    return {"expanded": expanded, "missing": missing}
