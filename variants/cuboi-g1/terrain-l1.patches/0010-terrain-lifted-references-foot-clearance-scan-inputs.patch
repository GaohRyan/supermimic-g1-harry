+        terms["foot_clearance"] = -dt * cfg.w_foot_clearance * foot_clearance_deficit(
+            robot_body_pos_w[..., foot_index, :], robot_body_lin_vel_w[..., foot_index, :], ground_fn, cfg)
+    else:
