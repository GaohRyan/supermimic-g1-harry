Date: Fri, 13 Nov 2026 01:07:31 -0500
Subject: [PATCH 05/19] opt: hard-example mining of world-model training
 windows (wm_trainer.hard_ratio)

Each world-model batch is built from 4x as many uniformly drawn candidate windows; a fraction hard_ratio of the batch
is drawn with probability proportional to the current open-loop window error, the rest stays uniform. Off by default.
Motivation: on closed-loop trajectories the model's 8-step error with the robot on the ground (5% of the data) is
7-13x the error while standing, and a model-free tracker (InstantTrack) does not lose score on the same clips.
---
 src/supermimic/world_model/hard_mining.py | 34 +++++++++++++++++++++++
 src/supermimic/world_model/wm_trainer.py  | 18 +++++++++++-
 2 files changed, 51 insertions(+), 1 deletion(-)
 create mode 100644 src/supermimic/world_model/hard_mining.py

diff --git a/src/supermimic/world_model/hard_mining.py b/src/supermimic/world_model/hard_mining.py
new file mode 100644
index 0000000..41ce788
--- /dev/null
+++ b/src/supermimic/world_model/hard_mining.py
@@ -0,0 +1,34 @@
+"""Hard-example mining for world-model windows (optimisation line).
+
+Uniform replay sampling gives the model few examples of the phases where it is least accurate (e.g. the robot on the
+ground: about 5 % of the data, 4-13x the error of standing). With mining, each training batch is built from a larger
+uniformly drawn candidate set: a fraction `ratio` of the batch is drawn with probability proportional to the current
+open-loop window error (error ** alpha), the rest stays uniform. Pure torch.
+"""
+
+from __future__ import annotations
+
+import torch
+
+
+@torch.no_grad()
+def window_error(wm, states: torch.Tensor, a_exec: torch.Tensor, xi: torch.Tensor) -> torch.Tensor:
+    """Mean open-loop normalised squared error over the window, per sample (n,). states (k+1,n,S), a_exec (k,n,A)."""
+    k = a_exec.shape[0]
+    s = states[0]
+    err = torch.zeros(states.shape[1], device=states.device)
+    for j in range(k):
+        s = wm.step(s, a_exec[j], xi)
+        err = err + wm.spec.normalized_sq_error(s, states[j + 1])
+    return torch.nan_to_num(err / k, nan=0.0, posinf=1.0e3).clamp(0.0, 1.0e3)
+
+
+@torch.no_grad()
+def mine_indices(err: torch.Tensor, batch: int, ratio: float, alpha: float = 1.0) -> torch.Tensor:
+    """Indices (batch,) into the candidate set: int(batch*ratio) drawn ~ err**alpha without replacement, the rest are
+    the first candidates (the candidates are i.i.d. uniform draws, so any fixed subset is a uniform sample)."""
+    n_hard = min(int(round(batch * ratio)), err.numel())
+    p = (err + 1.0e-8) ** alpha
+    hard = torch.multinomial(p, n_hard, replacement=False)
+    uni = torch.arange(batch - n_hard, device=err.device)
+    return torch.cat([hard, uni])
diff --git a/src/supermimic/world_model/wm_trainer.py b/src/supermimic/world_model/wm_trainer.py
index d4bad76..3d5e3a9 100644
--- a/src/supermimic/world_model/wm_trainer.py
+++ b/src/supermimic/world_model/wm_trainer.py
@@ -10,6 +10,7 @@ from supermimic.data.replay_buffer import ReplayBuffer, WindowBatch
 from supermimic.envs.mdp.motion_library import MotionLibrary
 from supermimic.world_model.heads import ReferenceFrame
 from supermimic.training.distributed import allreduce_grads
+from supermimic.world_model.hard_mining import mine_indices, window_error
 from supermimic.world_model.world_model import WorldModel
 
 
@@ -22,6 +23,10 @@ class WMTrainerCfg:
     grad_clip: float = 1.0
     weight_decay: float = 0.0
     compile: str | None = "default"
+    # Optimisation line: hard-example mining of the training windows (0 = off, plain uniform replay sampling).
+    hard_ratio: float = 0.0  # fraction of each batch drawn ~ window error ** hard_alpha from the candidates
+    hard_candidates: int = 4  # candidate windows per batch slot (uniform draws)
+    hard_alpha: float = 1.0
 
 
 def reference_at(lib: MotionLibrary, frame: torch.Tensor) -> ReferenceFrame:
@@ -52,8 +57,19 @@ class WorldModelTrainer:
     def update(self, buffer: ReplayBuffer) -> dict[str, float]:
         agg: dict[str, torch.Tensor] = {}
         for _ in range(self.cfg.batches_per_update):
-            w = buffer.sample_windows(self.cfg.batch_size, self.cfg.window)
+            mined = None
+            if self.cfg.hard_ratio > 0:
+                c = buffer.sample_windows(self.cfg.batch_size * self.cfg.hard_candidates, self.cfg.window)
+                err = window_error(self.wm, c.states, c.a_exec, c.xi)
+                idx = mine_indices(err, self.cfg.batch_size, self.cfg.hard_ratio, self.cfg.hard_alpha)
+                w = WindowBatch(states=c.states[:, idx], a_exec=c.a_exec[:, idx], a_clean=c.a_clean[:, idx], xi=c.xi[idx],
+                                reward=c.reward[:, idx], done=c.done[:, idx], frame=c.frame[:, idx])
+                mined = (err.mean(), err[idx].mean())
+            else:
+                w = buffer.sample_windows(self.cfg.batch_size, self.cfg.window)
             loss, m = self.loss_on(w)
+            if mined is not None:
+                m["mine_err_candidates"], m["mine_err_batch"] = mined
             self.opt.zero_grad(set_to_none=True)
             loss.backward()
             allreduce_grads(self.wm)
