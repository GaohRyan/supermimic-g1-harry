+
+
+def relief_scaled(scan_fn, factor: float):
+    """Sensor-mismatch test: the scan the actor gets shows every height difference ``factor`` times as large as it is
+    (0.9: a 20 cm riser looks like 18 cm), around the mean of the scan so that the robot's own height stays right."""
+
+    def fn():
+        scan = scan_fn()
+        mean = scan.mean(-1, keepdim=True)
+        return mean + (scan - mean) * factor
+
+    return fn
+
+
+def actor_scan_for(policy, env, terrain=None, noise: float = 0.0):
+    """ActorScan for a policy with a height-scan input, None for a blind policy. ``terrain`` None = flat ground."""
+    return ActorScan(env, terrain, noise) if policy.cfg.scan_mode != "none" else None
