diff --git a/scripts/eval_terrain.py b/scripts/eval_terrain.py
new file mode 100644
index 0000000..7f06570
--- /dev/null
+++ b/scripts/eval_terrain.py
@@ -0,0 +1,116 @@
+"""Terrain evaluation: one fixed-length window per env on chosen tiles (terrain type x level) of the training terrain.
+
+  * the terrain is rebuilt from the checkpoint's config (same generator arguments and seed as in training);
+  * `--per-tile` envs per tile, each started at a locomotion-clip frame drawn uniformly, placed with the training
+    reset placement, no reset noise; deterministic policy, no observation / action noise, no domain randomisation
+    (foot friction 1.0); the level curriculum is off, an env stays on its tile;
+  * per tile: share not fallen, share completed with the climb actually done, tracking return with a fixed
+    denominator, progress along the reference (supermimic/eval/terrain_eval.py).
+
+Sensor tests for a policy with a height-scan input:
+  --scan flat            the actor is shown flat ground everywhere (how much does it use the scan?)
+  --scan-relief 0.9      every height difference in the actor's scan is scaled (a 20 cm riser looks like 18 cm)
+
+Output: <out>/results.json. The checkpoint is loaded with weights_only=True.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import pathlib
+import time
+from pathlib import Path
+
+import torch
+import tyro
+
+from supermimic.envs.mdp.motion_library import discover_npz
+from supermimic.envs.tracking_env_cfg import SuperMimicEnvCfgArgs, make_env_cfg
+from supermimic.eval.terrain_eval import format_rows, run_tile_windows, tile_list
+from supermimic.policy.nets import Policy, PolicyCfg
+from supermimic.terrain.actor_scan import actor_scan_for, relief_scaled
+from supermimic.terrain.terrain_cfg import TerrainArgs
+
+
+def sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+@torch.no_grad()
+def main(ckpt: Path, out: Path, npz_dir: Path = Path("data/npz/lafan1"), device: str = "cuda:0", types: tuple[str, ...] = ("flat", "stairs_up", "stairs_down", "stairs_random", "slope", "rough"),
+         levels: tuple[int, ...] = (0, 3, 6, 9), per_tile: int = 64, seconds: float = 10.0, scan: str = "terrain", scan_relief: float = 1.0, seed: int = 0,
+         heightfields: bool = False) -> None:
+    """heightfields: add the slope and rough height-field tiles to the terrain although the run was trained without them
+    (to measure how the simulator's height-field contact compares with the flat box tile)."""
+    assert scan in ("terrain", "flat"), scan
+    t0 = time.time()
+    torch.serialization.add_safe_globals([pathlib.PosixPath])
+    ck = torch.load(ckpt, map_location=device, weights_only=True)
+    cfg = ck["config"]
+    pc = cfg["policy"]
+    policy = Policy(PolicyCfg(**{k: (tuple(v) if isinstance(v, list) else v) for k, v in pc.items()})).to(device)
+    policy.load_state_dict(ck["policy"])
+    policy.eval()
+    env_cfg_saved = cfg["env"]
+    targs = TerrainArgs(**{k: (tuple(v) if isinstance(v, list) else v) for k, v in env_cfg_saved.get("terrain", {}).items()}) if env_cfg_saved.get("terrain") else TerrainArgs()
+    if heightfields:
+        targs.p_slope, targs.p_rough = max(targs.p_slope, 0.05), max(targs.p_rough, 0.05)
+    present = {"flat": targs.p_flat, "stairs_up": targs.p_stairs_up, "stairs_down": targs.p_stairs_down, "stairs_random": targs.p_random_stairs, "slope": targs.p_slope, "rough": targs.p_rough}
+    types = tuple(t for t in types if present.get(t, 0) > 0)  # tile types this terrain has
+    files = [str(f) for f in discover_npz(npz_dir)]
+    n = per_tile * len(types) * len(levels)
+    args = SuperMimicEnvCfgArgs(
+        npz_files=files, num_envs=n, future_frames=env_cfg_saved["future_frames"], episode_length_s=seconds, action_noise_std=0.0, obs_noise=False, reset_noise=False,
+        domain_randomization=False, sampling_mode="return", record_transitions=False, seed=seed, anchor_obs=env_cfg_saved.get("anchor_obs", False),
+        anchor_obs_mode=env_cfg_saved.get("anchor_obs_mode", "full"), goal_contract=env_cfg_saved.get("goal_contract", "cuboi"), sampler_clip_end_norm=True,
+        terrain=targs, terrain_max_init_level=None, terrain_clip_regex=env_cfg_saved.get("terrain_clip_regex", r"^(walk|run|sprint)"),
+        extra_command_kwargs={"terrain_curriculum": False},
+    )
+    from mjlab.envs import ManagerBasedRlEnv
+    from mjlab.utils.torch import configure_torch_backends
+
+    configure_torch_backends()
+    env = ManagerBasedRlEnv(make_env_cfg(args), device=device)
+    try:
+        cmd = env.command_manager.get_term("motion")
+        ent = cmd.terrain_entity
+        tiles = tile_list(cmd.terrain_names, list(types), list(levels))
+        tile_of = torch.arange(n, device=device) // per_tile
+        ent.terrain_types[:] = torch.tensor([tiles[i][0] for i in tile_of.tolist()], device=device)
+        ent.terrain_levels[:] = torch.tensor([tiles[i][1] for i in tile_of.tolist()], device=device)
+        ent.env_origins[:] = ent.terrain_origins[ent.terrain_levels, ent.terrain_types]
+        obs, _ = env.reset()
+        scan_fn = actor_scan_for(policy, env, None if scan == "flat" else cmd.terrain)
+        if scan_fn is not None and scan_relief != 1.0:
+            scan_fn = relief_scaled(scan_fn, scan_relief)
+
+        def step(action):
+            o, rew, term, tout, _ = env.step(action)
+            return o, rew, term, tout
+
+        res = run_tile_windows(cmd, step, obs, policy, scan_fn, tile_of, tiles, int(env.max_episode_length), targs)
+        out.mkdir(parents=True, exist_ok=True)
+        report = {
+            "schema_version": 1, "protocol_id": "cuboi-g1/terrain-window-nominal-v1", "checkpoint": str(ckpt), "checkpoint_sha256": sha256(ckpt),
+            "checkpoint_meta": {"iteration": ck.get("iteration"), "num_updates": ck.get("num_updates")}, "policy_scan_mode": policy.cfg.scan_mode,
+            "scan_fed": scan, "scan_relief": scan_relief, "terrain_args": vars(targs), "per_tile": per_tile, "seconds": seconds, "seed": seed,
+            "env_args": {k: (vars(v) if k == "terrain" else v) for k, v in vars(args).items() if k != "npz_files"},
+            "tiles": res["tiles"], "wall_seconds": time.time() - t0, "torch": torch.__version__,
+        }
+        (out / "results.json").write_text(json.dumps(report, indent=1, default=str))
+        torch.save(res["per_env"], out / "per_env.pt")
+        print(format_rows(res["tiles"]))
+        stairs = [r for r in res["tiles"] if "stairs" in r["type"]]
+        if stairs:
+            print("terrain_summary", json.dumps({"stairs_not_fallen": sum(r["not_fallen"] for r in stairs) / len(stairs), "stairs_completed_with_climb": sum(r["completed_with_climb"] for r in stairs) / len(stairs)}))
+    finally:
+        env.close()
+
+
+if __name__ == "__main__":
+    tyro.cli(main)
