diff --git a/src/supermimic/eval/terrain_eval.py b/src/supermimic/eval/terrain_eval.py
new file mode 100644
index 0000000..0b23c5b
--- /dev/null
+++ b/src/supermimic/eval/terrain_eval.py
@@ -0,0 +1,105 @@
+"""Evaluation on the generated terrain: one fixed-length window per env on a chosen tile (terrain type x level).
+
+Pure torch on top of the command term's API, so the same loop runs under mjlab on the GPU (scripts/eval_terrain.py) and
+in the plain-MuJoCo stand-in on a laptop (tools/terrain/local_terrain_run.py of the main repository).
+
+Per tile it reports (docs/plans/terrain-PLAN.md section 5)
+  not_fallen            share of windows without a termination;
+  completed_with_climb  not fallen AND, when the reference path crosses at least two risers, the robot's accumulated
+                        height change is at least 70 % of the reference path's (standing at the foot of the stairs does
+                        not count);
+  norm_return           tracking reward / (0.1 x planned steps): fixed denominator, a fall keeps its zeros;
+  progress_ratio        distance covered along the reference travel direction / distance the reference travelled.
+Heights are the mean terrain height under the body (the base lift), which crosses a step edge smoothly: its accumulated
+change counts every riser once and is not inflated when the root wobbles over an edge.
+"""
+
+from __future__ import annotations
+
+import torch
+
+MAX_STEP_REWARD = 0.1
+CLIMB_SHARE = 0.7
+
+
+def tile_list(terrain_names: list[str], types: list[str], levels: list[int]) -> list[tuple[int, int]]:
+    """[(column, level)] for every requested type x level."""
+    return [(terrain_names.index(t), lv) for t in types for lv in levels]
+
+
+def riser_of(terrain_args, level: int) -> float:
+    lo, hi = terrain_args.step_height_range
+    return lo + (hi - lo) * level / max(terrain_args.num_levels - 1, 1)
+
+
+@torch.no_grad()
+def run_tile_windows(cmd, step, obs, policy, scan_fn, tile_of: torch.Tensor, tiles: list[tuple[int, int]], steps: int, terrain_args) -> dict:
+    """cmd: the motion command term of a terrain env whose envs were placed on their tiles and reset (curriculum off);
+    step(action) -> (obs, reward, terminated, timed_out); scan_fn() -> (N, 187) or None for a blind policy.
+    Only the first episode of every env counts. Returns {"tiles": [per-tile rows], "per_env": {...}}."""
+    from supermimic.kinematics.rotations import heading_yaw
+
+    n = tile_of.numel()
+    dev = tile_of.device
+    alive = torch.ones(n, dtype=torch.bool, device=dev)
+    fell = torch.zeros(n, dtype=torch.bool, device=dev)
+    rsum = torch.zeros(n, device=dev)
+    nsteps = torch.zeros(n, device=dev)
+    planned = cmd.ep_possible.clone().float()  # steps the window can last (the clip may end first)
+    up, down, up_ref, down_ref = (torch.zeros(n, device=dev) for _ in range(4))
+    prog, refd = torch.zeros(n, device=dev), torch.zeros(n, device=dev)
+
+    def heights():
+        ref_pos = cmd._ref.root_pos_w.float() + cmd.origin
+        h_ref = ref_pos[:, 2] - cmd.terrain.scan(ref_pos, heading_yaw(cmd._ref.root_quat_w.float()), cmd.patch_pattern).mean(-1)
+        return cmd.robot_base_lift(), h_ref
+
+    h, h_ref = heights()
+    for _ in range(steps):
+        act = policy(obs["policy"], obs["goal"], scan=scan_fn() if scan_fn is not None else None)
+        obs, rew, term, tout = step(act)
+        rsum += rew * alive
+        nsteps += alive.float()
+        done = (term | tout) & alive
+        fell |= term & alive
+        still = alive & ~done
+        h2, h_ref2 = heights()  # for an env that just ended these are post-reset values: masked out by ``still``
+        for acc, d in ((up, (h2 - h).clamp_min(0)), (down, (h - h2).clamp_min(0)), (up_ref, (h_ref2 - h_ref).clamp_min(0)), (down_ref, (h_ref - h_ref2).clamp_min(0))):
+            acc += d * still
+        h, h_ref = h2, h_ref2
+        prog = torch.where(still, cmd.ep_progress, prog)
+        refd = torch.where(still, cmd.ep_ref_dist, refd)
+        alive = still
+        if not alive.any():
+            break
+    change, change_ref = up + down, up_ref + down_ref
+    rows = []
+    for i, (col, lv) in enumerate(tiles):
+        m = tile_of == i
+        name = cmd.terrain_names[col]
+        riser = riser_of(terrain_args, lv)
+        # A window only has to show a climb when its reference path crosses at least two risers.
+        needs_climb = (change_ref[m] >= 2 * riser) if "stairs" in name else torch.zeros(int(m.sum()), dtype=torch.bool, device=dev)
+        ok = ~fell[m]
+        climbed = change[m] / change_ref[m].clamp_min(1e-6) >= CLIMB_SHARE
+        rows.append({
+            "type": name, "level": int(lv), "riser_cm": round(100 * riser, 1), "windows": int(m.sum()),
+            "not_fallen": float(ok.float().mean()),
+            "completed_with_climb": float((ok & (~needs_climb | climbed)).float().mean()),
+            "norm_return_fixed_denominator": float((rsum[m] / (MAX_STEP_REWARD * planned[m])).mean()),
+            "progress_ratio_mean": float((prog[m] / refd[m].clamp_min(1e-6)).mean()),
+            "ref_height_change_m_mean": float(change_ref[m].mean()),
+            "robot_height_change_m_mean": float(change[m].mean()),
+            "windows_with_stairs_on_the_path": float(needs_climb.float().mean()),
+        })
+    per_env = {"tile": tile_of.cpu(), "fell": fell.cpu(), "steps": nsteps.cpu(), "planned_steps": planned.cpu(), "reward_sum": rsum.cpu(),
+               "height_change": change.cpu(), "ref_height_change": change_ref.cpu(), "progress": prog.cpu(), "ref_distance": refd.cpu()}
+    return {"tiles": rows, "per_env": per_env}
+
+
+def format_rows(rows: list[dict]) -> str:
+    out = [f"{'type':14s} {'riser':>7s} {'n':>4s} {'not fallen':>10s} {'done+climbed':>12s} {'return':>7s} {'progress':>8s} {'height change ref/robot (m)':>27s}"]
+    for r in rows:
