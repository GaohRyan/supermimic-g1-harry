diff --git a/tests/test_optim.py b/tests/test_optim.py
new file mode 100644
index 0000000..c9e4c79
--- /dev/null
+++ b/tests/test_optim.py
@@ -0,0 +1,54 @@
+"""AdamW with weight_decay 0 must reproduce the Adam used before (fresh and when resuming an Adam checkpoint); the Muon
+layout must put only the hidden Linear weights on Muon. Pure torch."""
+import copy
+
+import torch
+
+from supermimic.training.optim import MultiOpt, build_optimizer, hidden_linear_weights, load_optimizer_state
+from supermimic.world_model.dynamics import MLP
+
+
+def _train(net, opt, seed, steps):
+    torch.manual_seed(seed)
+    x, y = torch.randn(256, 20), torch.randn(256, 7)
+    for _ in range(steps):
+        loss = ((net(x) - y) ** 2).mean()
+        opt.zero_grad()
+        loss.backward()
+        opt.step()
+
+
+def _diff(a, b):
+    return max((p - q).abs().max().item() for p, q in zip(a.parameters(), b.parameters()))
+
+
+def test_adamw_equals_adam_fresh_and_on_resume():
+    torch.manual_seed(1)
+    a = MLP(20, (64, 64, 64), 7)
+    b = copy.deepcopy(a)
+    oa = torch.optim.Adam(a.parameters(), lr=2e-4, betas=(0.9, 0.95))
+    ob = build_optimizer(b, 2e-4, betas=(0.9, 0.95))
+    _train(a, oa, 0, 25)
+    _train(b, ob, 0, 25)
+    assert _diff(a, b) == 0.0
+    sd = oa.state_dict()
+    na, nb = copy.deepcopy(a), copy.deepcopy(a)
+    o1 = torch.optim.Adam(na.parameters(), lr=2e-4, betas=(0.9, 0.95))
+    o1.load_state_dict(copy.deepcopy(sd))
+    o2 = build_optimizer(nb, 2e-4, betas=(0.9, 0.95))
+    assert load_optimizer_state(o2, copy.deepcopy(sd), betas=(0.9, 0.95), weight_decay=0.0)
+    _train(na, o1, 2, 10)
+    _train(nb, o2, 2, 10)
+    assert _diff(na, nb) == 0.0
+
+
+def test_muon_layout_and_state():
+    m = MLP(20, (64, 64, 64), 7)
+    opt = build_optimizer(m, 2e-4, hidden="muon")
+    assert isinstance(opt, MultiOpt) and [type(o).__name__ for o in opt.opts] == ["AdamW", "Muon"]
+    assert [tuple(p.shape) for p in hidden_linear_weights(m)] == [(64, 64), (64, 64)]
+    _train(m, opt, 0, 5)
+    assert all(torch.isfinite(p).all() for p in m.parameters())
+    adam_sd = torch.optim.Adam(MLP(20, (64, 64, 64), 7).parameters()).state_dict()
+    assert not load_optimizer_state(build_optimizer(MLP(20, (64, 64, 64), 7), 2e-4, hidden="muon"), adam_sd)
+    assert load_optimizer_state(build_optimizer(MLP(20, (64, 64, 64), 7), 2e-4, hidden="muon"), opt.state_dict())
