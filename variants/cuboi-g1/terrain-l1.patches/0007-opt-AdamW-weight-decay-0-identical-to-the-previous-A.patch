diff --git a/src/supermimic/training/optim.py b/src/supermimic/training/optim.py
new file mode 100644
index 0000000..686fca4
--- /dev/null
+++ b/src/supermimic/training/optim.py
@@ -0,0 +1,82 @@
+"""Optimizer construction shared by the world-model and policy trainers.
+
+Default: AdamW with weight_decay 0.0, which is numerically identical to the Adam used before (the two differ only in how a
+non-zero weight decay is applied); it is the base for later weight-decay experiments.
+Option hidden="muon" (ablation, as the official SuperMimic release, learners/learner_utils.py::build_optimizers): Muon on
+the Linear weights between the first and the last Linear of every nn.Sequential, AdamW on everything else, same lr.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+
+
+class MultiOpt:
+    """Several optimizers behind the small part of the Optimizer interface the trainers use."""
+
+    def __init__(self, opts: list[torch.optim.Optimizer]):
+        self.opts = opts
+
+    @property
+    def param_groups(self) -> list[dict]:
+        return [g for o in self.opts for g in o.param_groups]
+
+    def zero_grad(self, set_to_none: bool = True) -> None:
+        for o in self.opts:
+            o.zero_grad(set_to_none=set_to_none)
+
+    def step(self) -> None:
+        for o in self.opts:
+            o.step()
+
+    def state_dict(self) -> dict:
+        return {"multi": [o.state_dict() for o in self.opts]}
+
+    def load_state_dict(self, sd: dict) -> None:
+        if "multi" not in sd or len(sd["multi"]) != len(self.opts):
+            raise ValueError("optimizer state does not match this optimizer layout")
+        for o, s in zip(self.opts, sd["multi"]):
+            o.load_state_dict(s)
+
+
+def hidden_linear_weights(module: nn.Module) -> list[nn.Parameter]:
+    out = []
+    for seq in module.modules():
+        if isinstance(seq, nn.Sequential):
+            out += [m.weight for m in [m for m in seq if isinstance(m, nn.Linear)][1:-1]]
+    return out
+
+
+def build_optimizer(module: nn.Module, lr: float, betas=(0.9, 0.999), weight_decay: float = 0.0, hidden: str = "adamw"):
+    betas = tuple(betas)
+    if hidden == "adamw":
+        return torch.optim.AdamW(module.parameters(), lr=lr, betas=betas, weight_decay=weight_decay)
+    assert hidden == "muon", hidden
+    hid = hidden_linear_weights(module)
+    ids = {id(p) for p in hid}
+    rest = [p for p in module.parameters() if id(p) not in ids]
+    adamw = torch.optim.AdamW(rest, lr=lr, betas=betas, weight_decay=weight_decay)
+    if not hid:
+        return adamw
+    return MultiOpt([adamw, torch.optim.Muon(hid, lr=lr, adjust_lr_fn="match_rms_adamw")])
+
+
+def load_optimizer_state(opt, sd: dict, *, betas=None, weight_decay: float | None = None) -> bool:
+    """Load a checkpointed optimizer state. A state saved by plain Adam loads into AdamW (same buffers); the hyper-parameters
+    of this run are re-applied afterwards (a state dict also carries the old ones). Returns False (state left fresh) when the
+    layouts differ, e.g. an Adam checkpoint resumed with hidden="muon"."""
+    try:
+        opt.load_state_dict(sd)
+    except (ValueError, KeyError, RuntimeError):
+        return False
+    for o in opt.opts if isinstance(opt, MultiOpt) else [opt]:
+        if isinstance(o, torch.optim.AdamW):
+            for g in o.param_groups:
+                if "decoupled_weight_decay" in g:
+                    g["decoupled_weight_decay"] = True
+                if weight_decay is not None:
+                    g["weight_decay"] = weight_decay
+                if betas is not None:
+                    g["betas"] = tuple(betas)
+    return True
