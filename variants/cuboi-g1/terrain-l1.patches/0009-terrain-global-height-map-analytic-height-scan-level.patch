index 0000000..9b4cfe1
--- /dev/null
+++ b/src/supermimic/terrain/scan_ae.py
@@ -0,0 +1,70 @@
+"""Autoencoder of the height scan. The encoder is pre-trained once, then frozen: the actor consumes its latent.
+
+Why a frozen, pre-trained encoder (docs/plans/terrain-PLAN.md, T5): it fixes the interface between perception and the
+actor, so a later depth-camera encoder only has to produce the same latent; and an encoder trained only by the policy
+gradient through the world model has been reported to degrade. The decoder exists for pre-training (and later as the
+reconstruction target of other sensors); it is not used for control.
+
+Input convention: scan = z_root - terrain height at the 17 x 11 pattern points; the network sees (scan - SCAN_OFFSET) /
+SCAN_SCALE, so a standing robot on flat ground is near zero.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+import torch.nn as nn
+
+SCAN_OFFSET = 0.8
+SCAN_SCALE = 0.25
+
+
+@dataclass
+class ScanAECfg:
+    scan_dim: int = 187
+    latent_dim: int = 32
+    hidden: tuple[int, ...] = (256, 128)
+
+
+def _mlp(dims, last_act: bool = False) -> nn.Sequential:
+    layers: list[nn.Module] = []
+    for i in range(len(dims) - 1):
+        layers.append(nn.Linear(dims[i], dims[i + 1]))
+        if i < len(dims) - 2 or last_act:
+            layers.append(nn.ELU())
+    return nn.Sequential(*layers)
+
+
+class ScanEncoder(nn.Module):
+    def __init__(self, cfg: ScanAECfg):
+        super().__init__()
+        self.cfg = cfg
+        self.net = _mlp((cfg.scan_dim, *cfg.hidden, cfg.latent_dim))
+
+    def forward(self, scan: torch.Tensor) -> torch.Tensor:
+        return self.net((scan - SCAN_OFFSET) / SCAN_SCALE)
+
+
+class ScanAE(nn.Module):
+    def __init__(self, cfg: ScanAECfg | None = None):
+        super().__init__()
+        self.cfg = cfg or ScanAECfg()
+        self.encoder = ScanEncoder(self.cfg)
+        self.decoder = _mlp((self.cfg.latent_dim, *reversed(self.cfg.hidden), self.cfg.scan_dim))
+
+    def forward(self, scan: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        z = self.encoder(scan)
+        return self.decoder(z) * SCAN_SCALE + SCAN_OFFSET, z
+
+
+def load_frozen_encoder(path, device="cpu") -> tuple[ScanEncoder, dict]:
+    """Encoder of a pre-trained autoencoder, in eval mode with gradients off. Returns (encoder, metadata)."""
+    ck = torch.load(path, map_location=device, weights_only=True)
+    cfg = ScanAECfg(scan_dim=ck["cfg"]["scan_dim"], latent_dim=ck["cfg"]["latent_dim"], hidden=tuple(ck["cfg"]["hidden"]))
+    enc = ScanEncoder(cfg).to(device)
+    enc.load_state_dict(ck["encoder"])
+    enc.eval()
+    for p in enc.parameters():
+        p.requires_grad_(False)
+    return enc, ck["meta"]
