+"""Global terrain height map and the analytic height scan built on it.
+
+One height map of the whole (static) terrain is rasterised once from the compiled MuJoCo model. Everything that needs
+terrain height reads it from this map: the actor's height scan in the simulator, the same scan on imagined states, the
+world-model / critic terrain input, the terrain-relative reference heights of the reward and the foot-clearance term.
+Using one function everywhere is what keeps "what training sees" equal to "what evaluation sees".
+
+Conventions
+  * heights[j, i] is the terrain height at world (x0 + (i + 0.5) * res, y0 + (j + 0.5) * res)  (cell centres).
+  * lookups take the nearest cell, so vertical risers stay sharp; outside the map the border value is returned.
+  * lookups carry no gradient with respect to the horizontal position (the terrain is treated as locally constant;
+    the derivative at a riser is meaningless). Gradients flow through the body height only.
+  * scan value of a point = z_root - terrain_height(point): positive = ground below the root (mjlab / legged_gym sign).
+
+Pure numpy / torch / mujoco: no mjlab import, usable on a laptop.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from dataclasses import dataclass
+
+import mujoco
+import numpy as np
+import torch
+
+DEFAULT_RESOLUTION = 0.025
+
+
+def _upright(xmat: np.ndarray, tol: float = 1e-6) -> bool:
+    return abs(xmat[2, 2] - 1.0) < tol
+
+
+def rasterize_terrain(model: mujoco.MjModel, resolution: float = DEFAULT_RESOLUTION, terrain_body: str = "terrain", margin: float = 1.0):
+    """Height map of the geoms of ``terrain_body``. Returns (heights float32 [ny, nx], x0, y0).
+
+    Supported exactly: upright boxes (any yaw), height fields, planes. Any other terrain geom raises (add it when a
+    terrain needs it) so that an unsupported shape can never be silently missing from the map.
+    """
+    data = mujoco.MjData(model)
+    mujoco.mj_forward(model, data)
+    bid = model.body(terrain_body).id
+    gids = [g for g in range(model.ngeom) if model.geom_bodyid[g] == bid]
+    if not gids:
+        raise ValueError(f"body {terrain_body!r} has no geoms")
+    lo, hi, base = np.array([np.inf, np.inf]), np.array([-np.inf, -np.inf]), None
+    for g in gids:
+        t, pos = model.geom_type[g], data.geom_xpos[g]
+        if t == mujoco.mjtGeom.mjGEOM_PLANE:
+            base = float(pos[2]) if base is None else max(base, float(pos[2]))
+            continue
+        if t == mujoco.mjtGeom.mjGEOM_BOX:  # exact footprint (the bounding sphere of a long border box is far too large)
+            xm = data.geom_xmat[g].reshape(3, 3)
+            hx, hy = model.geom_size[g][:2]
+            ext = np.array([abs(xm[0, 0]) * hx + abs(xm[0, 1]) * hy, abs(xm[1, 0]) * hx + abs(xm[1, 1]) * hy])
+        elif t == mujoco.mjtGeom.mjGEOM_HFIELD:
+            ext = np.asarray(model.hfield_size[model.geom_dataid[g]][:2], dtype=float)
+        else:
+            ext = np.full(2, float(model.geom_rbound[g]))
+        lo, hi = np.minimum(lo, pos[:2] - ext), np.maximum(hi, pos[:2] + ext)
+    if not np.isfinite(lo).all():  # plane only
+        lo, hi = np.array([-1.0, -1.0]), np.array([1.0, 1.0])
+    x0, y0 = np.floor((lo - margin) / resolution) * resolution
+    nx = int(np.ceil((hi[0] + margin - x0) / resolution))
+    ny = int(np.ceil((hi[1] + margin - y0) / resolution))
+    heights = np.full((ny, nx), -np.inf, dtype=np.float32)
+    if base is not None:
+        heights[:] = base
+
+    def cells(xmin, xmax, ymin, ymax):
+        i0 = max(0, int(np.floor((xmin - x0) / resolution - 0.5)) + 1)
+        i1 = min(nx - 1, int(np.ceil((xmax - x0) / resolution - 0.5)) - 1)
+        j0 = max(0, int(np.floor((ymin - y0) / resolution - 0.5)) + 1)
+        j1 = min(ny - 1, int(np.ceil((ymax - y0) / resolution - 0.5)) - 1)
+        return i0, i1, j0, j1
+
+    for g in gids:
+        t, pos, xmat = model.geom_type[g], data.geom_xpos[g], data.geom_xmat[g].reshape(3, 3)
+        if t == mujoco.mjtGeom.mjGEOM_PLANE:
+            continue
+        if t == mujoco.mjtGeom.mjGEOM_BOX:
+            if not _upright(xmat):
+                raise NotImplementedError(f"tilted box geom {model.geom(g).name!r} is not supported by the height map")
+            hx, hy, hz = model.geom_size[g]
+            top = float(pos[2] + hz)
+            c, s = xmat[0, 0], xmat[1, 0]  # yaw rotation
+            ex, ey = abs(c) * hx + abs(s) * hy, abs(s) * hx + abs(c) * hy
+            i0, i1, j0, j1 = cells(pos[0] - ex, pos[0] + ex, pos[1] - ey, pos[1] + ey)
+            if i1 < i0 or j1 < j0:
+                continue
+            xs = x0 + (np.arange(i0, i1 + 1) + 0.5) * resolution - pos[0]
+            ys = y0 + (np.arange(j0, j1 + 1) + 0.5) * resolution - pos[1]
+            X, Y = np.meshgrid(xs, ys)
+            inside = (np.abs(c * X + s * Y) <= hx) & (np.abs(-s * X + c * Y) <= hy)
+            sub = heights[j0 : j1 + 1, i0 : i1 + 1]
+            sub[inside] = np.maximum(sub[inside], top)
+        elif t == mujoco.mjtGeom.mjGEOM_HFIELD:
+            if not _upright(xmat) or abs(xmat[0, 0] - 1.0) > 1e-6:
+                raise NotImplementedError("rotated height fields are not supported by the height map")
+            hid = model.geom_dataid[g]
+            rx, ry, ez, _ = model.hfield_size[hid]
+            nrow, ncol, adr = model.hfield_nrow[hid], model.hfield_ncol[hid], model.hfield_adr[hid]
+            hf = model.hfield_data[adr : adr + nrow * ncol].reshape(nrow, ncol)  # row = y, col = x, values in [0, 1]
+            i0, i1, j0, j1 = cells(pos[0] - rx, pos[0] + rx, pos[1] - ry, pos[1] + ry)
+            if i1 < i0 or j1 < j0:
+                continue
+            xs = (x0 + (np.arange(i0, i1 + 1) + 0.5) * resolution - (pos[0] - rx)) / (2 * rx) * (ncol - 1)
+            ys = (y0 + (np.arange(j0, j1 + 1) + 0.5) * resolution - (pos[1] - ry)) / (2 * ry) * (nrow - 1)
+            xi, yi = np.clip(np.floor(xs).astype(int), 0, ncol - 2), np.clip(np.floor(ys).astype(int), 0, nrow - 2)
+            fx, fy = np.clip(xs - xi, 0, 1)[None, :], np.clip(ys - yi, 0, 1)[:, None]
+            a, b = hf[np.ix_(yi, xi)], hf[np.ix_(yi, xi + 1)]
+            c2, d = hf[np.ix_(yi + 1, xi)], hf[np.ix_(yi + 1, xi + 1)]
+            val = (a * (1 - fx) + b * fx) * (1 - fy) + (c2 * (1 - fx) + d * fx) * fy
+            sub = heights[j0 : j1 + 1, i0 : i1 + 1]
+            np.maximum(sub, (pos[2] + val * ez).astype(np.float32), out=sub)
+        else:
+            raise NotImplementedError(f"terrain geom type {int(t)} ({model.geom(g).name!r}) is not supported by the height map")
+    if not np.isfinite(heights).all():
+        heights[~np.isfinite(heights)] = float(np.nanmin(heights[np.isfinite(heights)])) if np.isfinite(heights).any() else 0.0
+    return heights, float(x0), float(y0)
+
+
+def terrain_signature(model: mujoco.MjModel, resolution: float, terrain_body: str = "terrain") -> str:
+    """Hash of everything the height map depends on (cache key / checkpoint guard)."""
+    bid = model.body(terrain_body).id
+    g = model.geom_bodyid == bid
+    h = hashlib.sha256()
+    for arr in (model.geom_type[g], model.geom_pos[g], model.geom_quat[g], model.geom_size[g], model.geom_dataid[g], model.hfield_size, model.hfield_data):
+        h.update(np.ascontiguousarray(arr).tobytes())
+    h.update(f"{resolution:.6f}".encode())
+    return h.hexdigest()
+
+
+@dataclass
+class ScanPattern:
+    """Horizontal sample offsets (P, 2) in the yaw-aligned frame of the body the scan is attached to."""
+
+    offsets: torch.Tensor
+    shape: tuple[int, int]
+
+    @classmethod
+    def grid(cls, x_range=(-0.8, 0.8), y_range=(-0.5, 0.5), resolution: float = 0.1, device="cpu") -> "ScanPattern":
+        """17 x 11 = 187 points for the defaults (the legged_gym / ACP planner scan). Order: x-major (x outer, y inner)."""
+        nx = int(round((x_range[1] - x_range[0]) / resolution)) + 1
+        ny = int(round((y_range[1] - y_range[0]) / resolution)) + 1
+        xs = torch.linspace(x_range[0], x_range[1], nx, device=device)
+        ys = torch.linspace(y_range[0], y_range[1], ny, device=device)
+        return cls(torch.stack(torch.meshgrid(xs, ys, indexing="ij"), -1).reshape(-1, 2), (nx, ny))
+
+    def to(self, device) -> "ScanPattern":
+        return ScanPattern(self.offsets.to(device), self.shape)
+
+
+class TerrainMap:
+    def __init__(self, heights: torch.Tensor, x0: float, y0: float, resolution: float):
+        self.heights = heights  # (ny, nx) on the training device
+        self.x0, self.y0, self.res = float(x0), float(y0), float(resolution)
+        self.ny, self.nx = heights.shape
+        self._flat = heights.reshape(-1)
+
+    @classmethod
+    def from_model(cls, model: mujoco.MjModel, resolution: float = DEFAULT_RESOLUTION, device="cpu", terrain_body: str = "terrain") -> "TerrainMap":
+        h, x0, y0 = rasterize_terrain(model, resolution, terrain_body)
+        return cls(torch.as_tensor(h, device=device), x0, y0, resolution)
+
+    @classmethod
+    def flat(cls, device="cpu", height: float = 0.0) -> "TerrainMap":
+        return cls(torch.full((2, 2), float(height), device=device), -1.0e6, -1.0e6, 1.0e6)
+
+    @property
+    def is_flat(self) -> bool:
+        return bool((self.heights == self.heights.flatten()[0]).all())
+
+    @torch.no_grad()
+    def height(self, xy: torch.Tensor) -> torch.Tensor:
+        """Terrain height at world positions xy (..., 2) -> (...). Nearest cell, no gradient."""
+        i = ((xy[..., 0] - self.x0) / self.res).floor().long().clamp_(0, self.nx - 1)
+        j = ((xy[..., 1] - self.y0) / self.res).floor().long().clamp_(0, self.ny - 1)
+        return self._flat[j * self.nx + i]
+
+    def scan(self, root_pos_w: torch.Tensor, yaw: torch.Tensor, pattern: ScanPattern) -> torch.Tensor:
+        """Height scan (..., P): z_root - terrain height at the pattern points placed around the root, yaw aligned.
+        The gradient flows through z_root only."""
+        c, s = torch.cos(yaw).detach()[..., None], torch.sin(yaw).detach()[..., None]
+        ox, oy = pattern.offsets[:, 0], pattern.offsets[:, 1]
+        xy = torch.stack([root_pos_w[..., 0:1].detach() + c * ox - s * oy, root_pos_w[..., 1:2].detach() + s * ox + c * oy], -1)
+        return root_pos_w[..., 2:3] - self.height(xy)
+
+    def state_dict(self) -> dict:
+        return {"heights": self.heights.detach().cpu(), "x0": self.x0, "y0": self.y0, "res": self.res}
+
+    @classmethod
+    def from_state_dict(cls, sd: dict, device="cpu") -> "TerrainMap":
+        return cls(sd["heights"].to(device), sd["x0"], sd["y0"], sd["res"])
diff --git a/src/supermimic/terrain/scan_ae.py b/src/supermimic/terrain/scan_ae.py
