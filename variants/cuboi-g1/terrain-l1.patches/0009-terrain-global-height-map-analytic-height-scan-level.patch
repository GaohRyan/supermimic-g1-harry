+"""Terrain of the level-1 terrain task: a curriculum grid of flat ground, stairs, slopes and rough ground.
+
+Rows are difficulty levels (0 = easiest), columns are terrain types. The tile is large enough to hold a whole LAFAN1
+clip without re-centring it: the 40 clips span x [-8.3, 8.1] m and y [-5.0, 5.2] m around the capture origin, and the
+actor (orientation feedback only) drifts by about 2 m, so a tile is 20 x 14 m with its origin at the tile centre.
+
+Only the terrain sub-modules of mjlab are imported (not the package root), so the same function also runs on a laptop
+through tools/terrain/mjlab_terrain_local.py.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+TILE_SIZE = (20.0, 14.0)
+
+
+@dataclass
+class TerrainArgs:
+    num_levels: int = 10
+    step_height_range: tuple[float, float] = (0.05, 0.20)  # riser: level 0 .. level num_levels-1 (legged_gym: 0.05 .. 0.23)
+    step_width: float = 0.30  # tread (legged_gym: 0.31)
+    slope_range: tuple[float, float] = (0.0, 0.30)  # rad
+    rough_range: tuple[float, float] = (0.0, 0.06)  # peak-to-peak height noise at the hardest level, m
+    # spawn shares of the columns; flat keeps half of the robots so that the flat-ground skills are not forgotten
+    p_flat: float = 0.5
+    p_stairs_up: float = 0.15
+    p_stairs_down: float = 0.15
+    p_random_stairs: float = 0.10
+    p_slope: float = 0.05
+    p_rough: float = 0.05
+    seed: int = 0
+
+
+def make_terrain_generator_cfg(a: TerrainArgs | None = None):
+    from mjlab.terrains.heightfield_terrains import HfPyramidSlopedTerrainCfg, HfRandomUniformTerrainCfg
+    from mjlab.terrains.primitive_terrains import (
+        BoxFlatTerrainCfg,
+        BoxInvertedPyramidStairsTerrainCfg,
+        BoxPyramidStairsTerrainCfg,
+        BoxRandomStairsTerrainCfg,
+    )
+    from mjlab.terrains.terrain_generator import TerrainGeneratorCfg
+
+    a = a or TerrainArgs()
+    sub = {
+        "flat": BoxFlatTerrainCfg(proportion=a.p_flat),
+        # pyramid: the robot meets steps going up towards the centre and down away from it
+        "stairs_up": BoxPyramidStairsTerrainCfg(proportion=a.p_stairs_up, step_height_range=a.step_height_range, step_width=a.step_width, platform_width=2.0),
+        "stairs_down": BoxInvertedPyramidStairsTerrainCfg(proportion=a.p_stairs_down, step_height_range=a.step_height_range, step_width=a.step_width, platform_width=2.0),
+        # every step of this staircase has its own height: the policy cannot rely on a constant riser
+        "stairs_random": BoxRandomStairsTerrainCfg(proportion=a.p_random_stairs, step_height_range=a.step_height_range, step_width=2 * a.step_width, platform_width=2.0, border_width=0.0),
+        "slope": HfPyramidSlopedTerrainCfg(proportion=a.p_slope, slope_range=a.slope_range, platform_width=2.0, horizontal_scale=0.1),
+        "rough": HfRandomUniformTerrainCfg(proportion=a.p_rough, noise_range=a.rough_range, noise_step=0.005, horizontal_scale=0.1, scale_with_difficulty=True),
+    }
+    sub = {k: v for k, v in sub.items() if v.proportion > 0}
+    return TerrainGeneratorCfg(seed=a.seed, curriculum=True, size=TILE_SIZE, border_width=5.0, border_height=1.0, num_rows=a.num_levels,
+                               num_cols=len(sub), color_scheme="height", sub_terrains=sub, difficulty_range=(0.0, 1.0))
diff --git a/tests/test_heightmap.py b/tests/test_heightmap.py
new file mode 100644
index 0000000..cbfd3db
--- /dev/null
+++ b/tests/test_heightmap.py
@@ -0,0 +1,85 @@
+"""Terrain height map: rasterisation against MuJoCo ray casts, lookup conventions, height scan. Pure mujoco / torch."""
+import math
+
+import mujoco
+import numpy as np
+import torch
+
+from supermimic.terrain.heightmap import ScanPattern, TerrainMap, rasterize_terrain, terrain_signature
+
+XML = """
+<mujoco>
+  <asset><hfield name="hf" nrow="21" ncol="31" size="3 2 0.5 0.1"/></asset>
+  <worldbody>
+    <body name="terrain">
+      <geom name="floor" type="plane" size="0 0 0.01"/>
+      <geom name="step1" type="box" size="1.0 0.5 0.1" pos="0 0 0.1"/>
+      <geom name="step2" type="box" size="0.5 0.5 0.2" pos="0 0 0.2"/>
+      <geom name="yawed" type="box" size="0.6 0.2 0.15" pos="3 1 0.15" euler="0 0 35"/>
+      <geom name="field" type="hfield" hfield="hf" pos="-5 0 0"/>
+    </body>
+    <body name="other" pos="0 0 3"><geom type="sphere" size="0.2"/></body>
+  </worldbody>
+</mujoco>
+"""
+
+
+def _model():
+    m = mujoco.MjModel.from_xml_string(XML)
+    yy, xx = np.meshgrid(np.linspace(0, 1, 21), np.linspace(0, 1, 31), indexing="ij")
+    m.hfield_data[:] = (0.5 + 0.5 * np.sin(4 * xx) * np.cos(3 * yy)).astype(np.float32).reshape(-1)  # smooth field
+    return m
+
+
+def _ray(model, data, xy):
+    gid = np.zeros(1, dtype=np.int32)
+    group = np.array([1, 0, 0, 0, 0, 0], dtype=np.uint8)
+    out = np.zeros(len(xy))
+    for k, p in enumerate(xy):
+        d = mujoco.mj_ray(model, data, np.array([p[0], p[1], 50.0]), np.array([0, 0, -1.0]), group, 1, model.body("other").id, gid)
+        out[k] = 50.0 - d
+    return out
+
+
+def test_map_matches_ray_casts():
+    model = _model()
+    data = mujoco.MjData(model)
+    mujoco.mj_forward(model, data)
+    res = 0.01
+    h, x0, y0 = rasterize_terrain(model, res)
