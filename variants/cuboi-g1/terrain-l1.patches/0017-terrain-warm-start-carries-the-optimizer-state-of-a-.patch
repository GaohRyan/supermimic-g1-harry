         if ck["bin_return"].shape == self.command.bin_return.shape:  # same motion library: keep the sampler's difficulty estimates
diff --git a/tests/test_terrain_lifts.py b/tests/test_terrain_lifts.py
index a0b8a10..9bbf533 100644
--- a/tests/test_terrain_lifts.py
+++ b/tests/test_terrain_lifts.py
@@ -143,3 +143,32 @@ def test_expanded_checkpoint_and_optimizer_state():
     # a layout that does not match is refused
     other = torch.nn.Sequential(torch.nn.Linear(10, 8), torch.nn.ELU(), torch.nn.Linear(8, 3))
     assert expand_optimizer_state(opt.state_dict(), list(other.parameters())) is None
+
+
+def test_expanded_optimizer_state_with_muon_on_the_hidden_layers():
+    """Warm start from a run that used Muon on the hidden weights: both parts of the optimizer state carry over."""
+    pytest.importorskip("torch.optim", reason="torch")
+    if not hasattr(torch.optim, "Muon"):
+        pytest.skip("this torch has no Muon")
+    from supermimic.training.optim import build_optimizer, load_optimizer_state
+
+    torch.manual_seed(0)
+    mk = lambda n_in: torch.nn.Sequential(torch.nn.Linear(n_in, 16), torch.nn.ELU(), torch.nn.Linear(16, 16), torch.nn.ELU(), torch.nn.Linear(16, 3))  # noqa: E731
+    old, new = mk(6), mk(10)
+    opt = build_optimizer(old, 1e-3, hidden="muon")
+    x = torch.randn(32, 6)
+    for _ in range(4):
+        opt.zero_grad()
+        old(x).pow(2).mean().backward()
+        opt.step()
+    load_state_dict_expand(new, old.state_dict())
+    opt2 = build_optimizer(new, 1e-3, hidden="muon")
+    sd = expand_optimizer_state(opt.state_dict(), opt2)
+    assert sd is not None and load_optimizer_state(opt2, sd)
+    for o, net, inp in ((opt, old, x), (opt2, new, torch.cat([x, torch.zeros(32, 4)], -1))):
+        o.zero_grad()
+        net(inp).pow(2).mean().backward()
+        o.step()
+    assert torch.allclose(new[0].weight[:, :6], old[0].weight, atol=1e-6) and torch.allclose(new[2].weight, old[2].weight, atol=1e-6)
+    # an AdamW-only state does not fit the two-part optimizer: refused, the caller starts that optimizer fresh
+    assert expand_optimizer_state(torch.optim.AdamW(old.parameters()).state_dict(), opt2) is None
