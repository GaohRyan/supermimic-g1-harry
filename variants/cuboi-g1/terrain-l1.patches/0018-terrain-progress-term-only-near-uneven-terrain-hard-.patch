From 372ea6f4b487b43d4efe6548e7a22dc91feb808a Mon Sep 17 00:00:00 2001
From: Hang(Harry) Gao <GaohRyan@users.noreply.github.com>
Date: Sun, 15 Nov 2026 20:38:25 -0500
Subject: [PATCH 18/19] terrain: progress term only near uneven terrain; hard
 clips get a larger share of the flat-tile resets

Line T1 lost 0.04 of flat full-clip return; without the progress term (line T2) the flat score came back by 0.025 but
the share of 20 cm climbs actually completed fell by about 0.2. So: the term counts only where the height scan around
the robot spans more than progress_relief (2 cm), and the clips that never start on stair tiles are sampled with
weight flat_hard_boost (2) on flat tiles (their share of flat resets 0.49 -> 0.67).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/supermimic/config.py                | 2 ++
 src/supermimic/envs/mdp/commands.py     | 5 +++++
 src/supermimic/envs/mdp/rewards.py      | 4 ++++
 src/supermimic/envs/tracking_env_cfg.py | 3 ++-
 src/supermimic/imagination/compiled.py  | 6 +++++-
 src/supermimic/training/loop.py         | 2 ++
 src/supermimic/world_model/heads.py     | 3 ++-
 7 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/src/supermimic/config.py b/src/supermimic/config.py
index f4b21f6..587e92c 100644
--- a/src/supermimic/config.py
+++ b/src/supermimic/config.py
@@ -50,6 +50,8 @@ class EnvCfg:
     # front of the stairs). Measured on the references: a robot that tracks everything but steps on the spot keeps
     # 0.84-0.87 of the maximum tracking reward on walking clips, more than the trained policy gets while it walks.
     progress_weight: float = 1.0
+    progress_relief: float = 0.02  # m; the progress term counts only where the scan around the robot spans more than this (0 = everywhere, as in line T1)
+    flat_hard_boost: float = 2.0  # on flat tiles, sampling weight of the clips that never start on stair tiles (1 = no boost, as in line T1)
 
 
 @dataclass
diff --git a/src/supermimic/envs/mdp/commands.py b/src/supermimic/envs/mdp/commands.py
index 6e85c7e..53677f0 100644
--- a/src/supermimic/envs/mdp/commands.py
+++ b/src/supermimic/envs/mdp/commands.py
@@ -485,6 +485,10 @@ class MultiClipMotionCommand(CommandTerm):
             if on_terrain.any():
                 pt = p * self.bin_on_terrain
                 b[on_terrain] = torch.multinomial(pt / pt.sum(), int(on_terrain.sum()), replacement=True)
+            if cfg.flat_hard_boost != 1.0 and (~on_terrain).any():
+                # The clips that never start on a non-flat tile only get the flat-tile envs: give them a larger share there.
+                pf = p * (1.0 + (cfg.flat_hard_boost - 1.0) * (1.0 - self.bin_on_terrain))
+                b[~on_terrain] = torch.multinomial(pf / pf.sum(), int((~on_terrain).sum()), replacement=True)
         u = torch.rand(n, device=self.device)
         f = lib.bin_start[b] + (u * (lib.bin_end[b] - lib.bin_start[b]).float()).long()
         f = torch.minimum(f, lib.last_frame_of(f) - 2).clamp_min(lib.clip_start[lib.frame_clip[f]])
@@ -666,6 +670,7 @@ class MultiClipMotionCommandCfg(CommandTermCfg):
     terrain_task: bool = False
     terrain_resolution: float = 0.025  # m per cell of the global height map
     terrain_clip_regex: str = r"^(walk|run|sprint)"  # clips that may start on a non-flat tile; the others stay on flat tiles
+    flat_hard_boost: float = 1.0  # on flat tiles: sampling weight of the bins that may not start on a non-flat tile
     terrain_curriculum: bool = True  # False: envs stay on the tile they were put on (evaluation)
     level_up_reward_ratio: float = 0.8  # promote: mean reward >= this share of what the same motion bins earn on flat tiles,
     level_up_progress: float = 0.7  # distance covered along the reference travel direction >= this share of the reference's,
diff --git a/src/supermimic/envs/mdp/rewards.py b/src/supermimic/envs/mdp/rewards.py
index 3adf99c..95377f6 100644
--- a/src/supermimic/envs/mdp/rewards.py
