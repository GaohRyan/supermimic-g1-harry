@@ -48,7 +48,11 @@ class ImagStep:
             ground_fn = self.wm.ground_fn(origin)
         else:
             scan_next, lift, ground_fn = None, None, None
-        terms = self.wm.heads.reward(s_next, a, a_prev, ref, bodies, base_lift=lift, ground_fn=ground_fn)
+        relief = self.wm.heads.reward_cfg.progress_relief
+        # Progress is only asked for near uneven terrain (stopping in front of stairs is the failure it guards against);
