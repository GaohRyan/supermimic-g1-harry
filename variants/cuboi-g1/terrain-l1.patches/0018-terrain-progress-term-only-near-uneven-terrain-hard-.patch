@@ -43,6 +43,7 @@ class TrackingRewardCfg:
     clearance_margin: float = 0.04  # m above the highest terrain point under / ahead of the foot
     clearance_sole_offset: float = 0.04  # height of the ankle-roll link origin above the sole (stance value of the references: 0.036-0.044)
     clearance_ahead: tuple[float, ...] = (0.0, 0.05, 0.10, 0.15)  # sample points along the direction of travel of the foot, m
+    progress_relief: float = 0.0  # > 0 (m): the progress term counts only where the height scan around the robot is not flat (max - min above this)
     w_progress: float = 0.0  # > 0: linear reward of the root speed along the reference travel direction, capped at the reference's speed (the terrain task turns it on: config.EnvCfg.progress_weight)
 
     @property
@@ -100,6 +101,7 @@ def tracking_reward_terms(
     leg_side: torch.Tensor | None = None,  # (B,) long: 0 = left, 1 = right (value irrelevant where leg_weight is 0)
     leg_weight: torch.Tensor | None = None,  # (B,) share of the foot's own terrain height in the lift of each body
     foot_index: torch.Tensor | None = None,  # (2,) tracked-body indices of the left / right foot
+    progress_gate: torch.Tensor | None = None,  # (N,) 0 / 1: where the progress term counts (None = everywhere)
 ) -> dict[str, torch.Tensor]:
     """Per-term weighted, dt-scaled rewards (N,) plus 'total'.
 
@@ -157,6 +159,8 @@ def tracking_reward_terms(
         speed_ref = v_ref.norm(dim=-1)
         along = (robot_body_lin_vel_w[..., anchor_index, :2] * v_ref).sum(-1) / speed_ref.clamp_min(1e-3)
         terms["progress"] = dt * cfg.w_progress * torch.minimum(along, speed_ref)  # no bonus for going faster than the reference
+        if progress_gate is not None:
+            terms["progress"] = terms["progress"] * progress_gate.detach()
     else:
         terms["progress"] = zero_n
     total = terms["motion_global_root_pos"]
