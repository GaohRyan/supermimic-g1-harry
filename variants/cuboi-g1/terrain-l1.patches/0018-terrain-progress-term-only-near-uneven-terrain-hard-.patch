+        gate = ((scan_next.amax(-1) - scan_next.amin(-1)) > relief).float() if (scan is not None and relief > 0) else None
+        terms = self.wm.heads.reward(s_next, a, a_prev, ref, bodies, base_lift=lift, ground_fn=ground_fn, progress_gate=gate)
         r = terms["total"]
         term_vec = torch.stack([terms[k] for k in REWARD_TERM_NAMES], dim=0)  # (10, n)
         logits = self.wm.termination_logits(s_next, ref, lift)
