new file mode 100644
index 0000000..f2103c8
--- /dev/null
+++ b/src/supermimic/terrain/actor_scan.py
@@ -0,0 +1,37 @@
+"""The height scan the actor is given in the simulator.
+
+It is the same lookup the imagined rollouts use (``WorldModel.scan``): the global height map read at the 17 x 11 points
+around the root of the current simulator state, plus the sensor noise. Training and every evaluation script build
+the actor's scan through this class, so there is exactly one definition of what the actor sees.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from supermimic.kinematics.rotations import heading_yaw
+from supermimic.terrain.heightmap import ScanPattern, TerrainMap
+
+
+class ActorScan:
+    def __init__(self, env, terrain: TerrainMap | None = None, noise: float = 0.0):
+        """``terrain`` None = flat ground (the scan is then the root height at every point)."""
+        from supermimic.envs.state_io import StateIO
+
+        self.io = StateIO(env)
+        self.terrain = terrain if terrain is not None else TerrainMap.flat(env.device)
+        self.pattern = ScanPattern.grid(device=env.device)
+        self.noise = float(noise)
+
+    @torch.no_grad()
+    def clean(self) -> torch.Tensor:
+        """(N, 187) noise-free scan of the current simulator state."""
+        s = self.io.read()
+        return self.terrain.scan(s[:, 0:3] + self.io.origins, heading_yaw(s[:, 3:7]), self.pattern)
+
+    @torch.no_grad()
+    def __call__(self) -> torch.Tensor:
+        scan = self.clean()
+        if self.noise > 0:
+            scan = scan + (torch.rand_like(scan) * 2 - 1) * self.noise
+        return scan
diff --git a/src/supermimic/terrain/expand.py b/src/supermimic/terrain/expand.py
index d296d2f..fd51693 100644
--- a/src/supermimic/terrain/expand.py
+++ b/src/supermimic/terrain/expand.py
@@ -39,3 +39,35 @@ def load_state_dict_expand(module: nn.Module, state: dict, allow_missing_prefixe
             raise ValueError(f"{k}: checkpoint shape {tuple(src.shape)} does not fit {tuple(dst.shape)}")
     module.load_state_dict(own)
     return {"expanded": expanded, "missing": missing}
+
+
+def expand_optimizer_state(sd: dict, params: list) -> dict | None:
+    """Fit an Adam / AdamW state saved for a network with fewer inputs to the extended network.
+
+    ``params``: the parameters of the extended network in optimizer order. The moment tensors of a weight whose input
+    dimension grew are padded with zeros (the new columns start with an empty history); everything else is kept, so
+    the trained part of the network continues with its accumulated moments instead of a cold optimizer.
+    Returns None when the state cannot be matched (other layout changes, several parameter groups)."""
+    import copy
+
+    if "state" not in sd or len(sd.get("param_groups", [])) != 1:
+        return None
+    idx = sd["param_groups"][0]["params"]
+    if len(idx) != len(params):
+        return None
+    out = copy.deepcopy(sd)
+    for i, p in zip(idx, params):
+        st = out["state"].get(i)
+        if st is None:
+            continue
+        for k in ("exp_avg", "exp_avg_sq", "max_exp_avg_sq"):
+            if k not in st or st[k].shape == p.shape:
+                continue
+            old = st[k]
+            if old.ndim == 2 and p.ndim == 2 and old.shape[0] == p.shape[0] and old.shape[1] < p.shape[1]:
+                new = torch.zeros(p.shape, dtype=old.dtype, device=old.device)
+                new[:, : old.shape[1]] = old
+                st[k] = new
+            else:
+                return None
+    return out
