@@ -0,0 +1,69 @@
+"""Level curriculum of the terrain task: who is promoted, who is demoted (MultiClipMotionCommand._update_terrain_levels).
+Pure torch, the command term's method is called on a stand-in object."""
+import types
+
+import pytest
+import torch
+
+pytest.importorskip("mjlab.utils.lab_api.math")
+
+from supermimic.envs.mdp.commands import MultiClipMotionCommand, MultiClipMotionCommandCfg  # noqa: E402
+
+T, NB = 500, 20
+
+
+def _run(cases, flat_seen: bool = True):
+    """cases: list of dicts (on_terrain, terminated, steps, reward, progress, ref_dist). Env 0 is always a flat-tile
+    episode with reward 0.08 per step that covers every bin (the yardstick)."""
+    cases = [dict(on_terrain=False, terminated=False, steps=T, reward=0.08, progress=1.0, ref_dist=5.0)] + cases
+    n = len(cases)
+    lens = torch.tensor([c["steps"] for c in cases])
+    rewards = torch.zeros(n, T)
+    for i, c in enumerate(cases):
+        rewards[i, : c["steps"]] = c["reward"]
+    moved = {}
+
+    def update_env_origins(env_ids, up, down):
+        moved["up"], moved["down"] = up.clone(), down.clone()
+
+    cfg = MultiClipMotionCommandCfg(npz_files=[], anchor_body_name="pelvis", body_names=("pelvis",))
+    me = types.SimpleNamespace(
+        cfg=cfg, device="cpu", library=types.SimpleNamespace(num_bins=NB), terrain_entity=types.SimpleNamespace(update_env_origins=update_env_origins),
+        ep_len=lens, ep_rewards=rewards, ep_bins=(torch.arange(T) // (T // NB)).repeat(n, 1),
+        flat_bin_reward=torch.zeros(NB), flat_bin_seen=torch.zeros(NB, dtype=torch.bool),
+        _env=types.SimpleNamespace(termination_manager=types.SimpleNamespace(terminated=torch.tensor([c["terminated"] for c in cases]))),
+        ep_ref_dist=torch.tensor([c["ref_dist"] for c in cases]), ep_progress=torch.tensor([c["progress"] * c["ref_dist"] for c in cases]),
+        ep_possible=torch.full((n,), T), level_moves=torch.zeros(3),
+        on_terrain=lambda ids: torch.tensor([c["on_terrain"] for c in cases])[ids],
+    )
+    ids = torch.arange(n) if flat_seen else torch.arange(1, n)
+    MultiClipMotionCommand._update_terrain_levels(me, ids)
+    return moved["up"].tolist(), moved["down"].tolist(), me
+
+
+def test_promotion_needs_no_fall_reward_and_progress():
+    good = dict(on_terrain=True, terminated=False, steps=T, reward=0.08, progress=0.9, ref_dist=5.0)
+    up, down, me = _run([
+        good,                                    # 1 tracks as well as on flat ground and keeps up        -> up
+        {**good, "progress": 0.2},              # 2 keeps the reward but stops in front of the stairs    -> stays
+        {**good, "reward": 0.04},               # 3 half the flat-ground reward                          -> stays
+        {**good, "ref_dist": 0.3},              # 4 the reference hardly moves                           -> stays
+        {**good, "reward": 0.07},               # 5 88 % of the flat-ground reward                       -> up
+        {**good, "terminated": True, "steps": 100},   # 6 fell after a fifth of the episode              -> down
+        {**good, "terminated": True, "steps": 400},   # 7 fell late                                      -> stays
+    ])
+    assert up == [False, True, False, False, False, True, False, False]
+    assert down == [False, False, False, False, False, False, True, False]
+    assert me.flat_bin_seen.all() and torch.allclose(me.flat_bin_reward, torch.full((NB,), 0.08))
+    assert me.level_moves.tolist() == [2.0, 1.0, 4.0]  # the flat-tile env is not counted
+
+
+def test_no_promotion_before_a_flat_episode_has_been_seen():
+    good = dict(on_terrain=True, terminated=False, steps=T, reward=0.08, progress=0.9, ref_dist=5.0)
+    up, down, _ = _run([good, {**good, "terminated": True, "steps": 50}], flat_seen=False)
+    assert up == [False, False] and down == [False, True]  # demotion does not need the yardstick
+
+
+def test_flat_tile_envs_never_move():
