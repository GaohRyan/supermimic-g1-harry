new file mode 100644
index 0000000..53a7dc3
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,75 @@
+"""Lets the tests that need no simulator run on a machine without the mjlab runtime (e.g. a laptop with the offline stub
+of tools/offline, which only has mjlab's math helpers).
+
+Without the runtime:
+  * supermimic.envs is registered bare (its __init__ imports the mjlab environment stack), so its pure-torch
+    sub-modules (state_io, mdp.rewards, mdp.commands ...) import normally;
+  * mjlab.managers gets minimal stand-ins of the base classes the variant subclasses (CommandTerm, RecorderTerm).
+With the real mjlab installed (GPU image) nothing is changed.
+"""
+import importlib.util
+import sys
+import types
+from dataclasses import dataclass
+from pathlib import Path
+
+
+def _mjlab_runtime() -> bool:
+    try:
+        import mjlab.envs  # noqa: F401
+
+        return True
+    except Exception:
+        return False
+
+
+if not _mjlab_runtime():
+    _src = Path(importlib.util.find_spec("supermimic").submodule_search_locations[0])
+    for _name, _sub in (("supermimic.envs", "envs"), ("supermimic.envs.mdp", "envs/mdp")):
+        if _name not in sys.modules:
+            _m = types.ModuleType(_name)
+            _m.__path__ = [str(_src / _sub)]
+            sys.modules[_name] = _m
+
+    class _TermBase:
+        def __init__(self, env):
+            self._env = env
+
+        @property
+        def num_envs(self):
+            return self._env.num_envs
+
+        @property
+        def device(self):
+            return self._env.device
+
+    class CommandTerm(_TermBase):
+        def __init__(self, cfg, env):
+            self.cfg = cfg
+            super().__init__(env)
+            self.metrics = {}
+
+    @dataclass(kw_only=True)
+    class CommandTermCfg:
+        resampling_time_range: tuple[float, float]
+        debug_vis: bool = False
+
+    class RecorderTerm(_TermBase):
+        def __init__(self, cfg, env):
+            self.cfg = cfg
+            super().__init__(env)
+
+    class RecorderTermCfg:
+        pass
+
+    try:
+        import mjlab  # noqa: F401  the offline stub, when present
+    except Exception:
+        sys.modules["mjlab"] = types.ModuleType("mjlab")
+    _man = types.ModuleType("mjlab.managers")
+    _man.__path__ = []
+    _man.CommandTerm, _man.CommandTermCfg = CommandTerm, CommandTermCfg
+    _rec = types.ModuleType("mjlab.managers.recorder_manager")
+    _rec.RecorderTerm, _rec.RecorderTermCfg = RecorderTerm, RecorderTermCfg
+    sys.modules["mjlab.managers"] = _man
+    sys.modules["mjlab.managers.recorder_manager"] = _rec
