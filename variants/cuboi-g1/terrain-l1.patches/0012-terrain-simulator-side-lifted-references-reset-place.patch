+    # ------------------------------------------------------------------ terrain task
+
+    def _setup_terrain(self) -> None:
+        import re
+
+        from supermimic.terrain.heightmap import ScanPattern, TerrainMap
+        from supermimic.terrain.lifts import leg_lift_layout
+
+        cfg, lib, n = self.cfg, self.library, self.num_envs
+        ent = self._env.scene.terrain
+        assert ent is not None and getattr(ent, "terrain_origins", None) is not None, "terrain_task needs a generator terrain in the scene"
+        self.terrain_entity = ent
+        # One global height map, built from the compiled model the simulator runs: the reference lifts here, the scan of
+        # the actor and the lookups of the imagined rollouts all read this object (Trainer hands it to the world model).
+        self.terrain = TerrainMap.from_model(self._env.sim.mj_model, cfg.terrain_resolution, device=self.device)
+        pattern = ScanPattern.grid(device=self.device)
+        self.patch_pattern = pattern.subset(pattern.patch_index())
+        self.leg_side, self.leg_weight, self.foot_index = leg_lift_layout(cfg.body_names, self.device)
+        assert self.foot_index is not None, "terrain_task needs both ankle-roll links among the tracked bodies"
+        self.terrain_names = list(ent.cfg.terrain_generator.sub_terrains.keys())
+        self.flat_col = self.terrain_names.index("flat") if "flat" in self.terrain_names else -1
+        ok = torch.tensor([re.search(cfg.terrain_clip_regex, c.name) is not None for c in lib.clips], device=self.device)
+        assert ok.any(), f"no clip matches terrain_clip_regex {cfg.terrain_clip_regex!r}"
+        self.bin_on_terrain = ok[lib.bin_clip].float()  # (num_bins,) 1 = the bin may start on a non-flat tile
+        # Level curriculum bookkeeping.
+        self.flat_bin_reward = torch.zeros(lib.num_bins, device=self.device)  # per-step reward of each bin on flat tiles (EMA)
+        self.flat_bin_seen = torch.zeros(lib.num_bins, dtype=torch.bool, device=self.device)
+        self.ep_progress = torch.zeros(n, device=self.device)  # m covered along the reference travel direction
+        self.ep_ref_dist = torch.zeros(n, device=self.device)  # m the reference travelled
+        self.ep_possible = torch.ones(n, dtype=torch.long, device=self.device)  # steps the episode can last at most
+        self.spawn_hover = torch.zeros(n, device=self.device)  # last reset: spawn lift - base lift (diagnostic)
+        self.level_moves = torch.zeros(3, device=self.device)  # up / down / stay since the last terrain_stats()
+        print(f"[INFO] terrain task: height map {self.terrain.ny} x {self.terrain.nx} cells of {cfg.terrain_resolution} m, tile types {self.terrain_names}, "
+              f"{int(ok.sum())}/{len(lib.clips)} clips may start on non-flat tiles")
+
+    def on_terrain(self, env_ids: torch.Tensor | None = None) -> torch.Tensor:
+        """Bool mask: the env stands on a non-flat tile type."""
+        t = self.terrain_entity.terrain_types
+        return (t if env_ids is None else t[env_ids]) != self.flat_col
+
+    def robot_base_lift(self) -> torch.Tensor:
+        """(N,) mean terrain height under the robot at its current root pose: the base lift of supermimic.terrain.lifts,
+        the same quantity WorldModel.base_lift computes from a state."""
+        from supermimic.kinematics.rotations import heading_yaw
+
+        pos = self.robot_root_pos_w
+        scan = self.terrain.scan(pos, heading_yaw(self.robot_root_quat_w), self.patch_pattern)
+        return (pos[:, 2] - scan.mean(-1)).detach()
+
+    def _spawn_lift(self, env_ids: torch.Tensor, root_pos: torch.Tensor, root_ori: torch.Tensor, origin: torch.Tensor, xy_shift: torch.Tensor | None) -> torch.Tensor:
+        """Height to add to the flat-ground reset pose of ``env_ids``: the base lift at the reset pose, raised until no
+        sole point of the reference pose is inside the terrain (plan T10). 0 on flat tiles."""
+        from supermimic.kinematics.rotations import heading_yaw
+        from supermimic.terrain.lifts import spawn_lift
+
+        scan = self.terrain.scan(root_pos, heading_yaw(root_ori), self.patch_pattern)
+        base = (root_pos[:, 2] - scan.mean(-1)).detach()
+        b = self.library.bodies(self.frame[env_ids])
+        foot_pos = b.pos_w[:, self.foot_index].float() + origin[:, None, :]
+        if xy_shift is not None:  # the reset noise moves the whole pose horizontally (its small rotation is ignored here)
+            foot_pos = torch.cat([foot_pos[..., :2] + xy_shift[:, None, :], foot_pos[..., 2:]], dim=-1)
+        lift = spawn_lift(base, foot_pos, b.quat_w[:, self.foot_index].float(), self.terrain.height)
+        self.spawn_hover[env_ids] = lift - base
+        return lift
+
+    def _start_episode_stats(self, env_ids: torch.Tensor) -> None:
+        f = self.frame[env_ids]
+        self.ep_progress[env_ids] = 0.0
+        self.ep_ref_dist[env_ids] = 0.0
+        self.ep_possible[env_ids] = torch.minimum(self.library.last_frame_of(f) - f, torch.full_like(f, int(self._env.max_episode_length))).clamp_min(1)
+
+    def _log_step_progress(self, env_mask: torch.Tensor | None = None) -> None:
+        """Distance covered this step along the travel direction of the reference (capped at the reference's own)."""
+        ids = torch.arange(self.num_envs, device=self.device) if env_mask is None else env_mask.nonzero().squeeze(-1)
+        if ids.numel() == 0:
+            return
+        v_ref = self._ref.root_lin_vel_w[ids, :2].float()
+        speed = v_ref.norm(dim=-1)
+        v = self.robot.data.body_link_lin_vel_w[ids, self.robot_root_body_index, :2]
+        along = (v * v_ref).sum(-1) / speed.clamp_min(1.0e-3)
+        dt = self._env.step_dt
+        self.ep_progress[ids] += torch.minimum(along, speed) * dt
+        self.ep_ref_dist[ids] += speed * dt
+
+    def _update_terrain_levels(self, env_ids: torch.Tensor) -> None:
+        """Level curriculum, judged on the episode that just ended (docs/plans/terrain-PLAN.md section 2).
+
+        Up one level: the episode did not fail, earned at least ``level_up_reward_ratio`` of what the same motion bins
+        earn on flat tiles, and covered at least ``level_up_progress`` of the reference's travel (a robot that stops in
+        front of the stairs keeps most of the tracking reward, so the reward alone is not enough).
+        Down one level: it failed before ``level_down_fraction`` of the steps it could have lasted.
+        Envs on flat tiles are never moved; their episodes maintain the flat-ground yardstick.
+        """
+        cfg, lib, ent = self.cfg, self.library, self.terrain_entity
+        lens = self.ep_len[env_ids]
+        if int(lens.sum().item()) == 0:
+            return  # the very first reset: no episode to judge
+        on_terrain = self.on_terrain(env_ids)
+        T = int(lens.max().item())
+        tmask = torch.arange(T, device=self.device)[None, :] < lens[:, None]
+        r = self.ep_rewards[env_ids, :T]
+        bins = self.ep_bins[env_ids, :T]
+        flat = ~on_terrain
+        if flat.any():
+            m = tmask[flat]
+            b, g = bins[flat][m], r[flat][m]
+            sums = torch.zeros(lib.num_bins, device=self.device).index_add_(0, b, g)
+            cnts = torch.zeros(lib.num_bins, device=self.device).index_add_(0, b, torch.ones_like(g))
+            touched = cnts > 0
+            mean = sums[touched] / cnts[touched]
+            a = cfg.flat_reward_ema
+            self.flat_bin_reward[touched] = torch.where(self.flat_bin_seen[touched], (1 - a) * self.flat_bin_reward[touched] + a * mean, mean)
+            self.flat_bin_seen[touched] = True
+        # Yardstick of every step: the flat-ground reward of its own bin; for a bin no flat env has visited yet, the mean
+        # over the bins seen so far (early in a run, or with few envs). No promotion before any flat episode has ended.
+        seen_any = bool(self.flat_bin_seen.any())
+        fallback = self.flat_bin_reward[self.flat_bin_seen].mean() if seen_any else torch.zeros((), device=self.device)
+        yard_step = torch.where(self.flat_bin_seen[bins], self.flat_bin_reward[bins], fallback)
+        yard = (yard_step * tmask).sum(1)
+        ratio = (r * tmask).sum(1) / yard.clamp_min(1.0e-6)
+        judged = (yard > 0) & seen_any
+        terminated = self._env.termination_manager.terminated[env_ids]
+        ref_dist = self.ep_ref_dist[env_ids]
+        progress = self.ep_progress[env_ids] / ref_dist.clamp_min(1.0e-6)
+        up = on_terrain & ~terminated & judged & (ratio >= cfg.level_up_reward_ratio) & (progress >= cfg.level_up_progress) & (ref_dist >= cfg.level_up_min_distance)
+        down = on_terrain & terminated & (lens.float() < cfg.level_down_fraction * self.ep_possible[env_ids].float())
+        ent.update_env_origins(env_ids, up, down)  # past the top row an env is sent to a random row
+        self.level_moves += torch.stack([up.sum(), down.sum(), (on_terrain & ~up & ~down).sum()]).float()
+
+    def terrain_stats(self) -> dict[str, float]:
+        """Curriculum numbers for the training log (also resets the move counters)."""
+        ent = self.terrain_entity
+        lv = ent.terrain_levels.float()
+        out: dict[str, float] = {}
+        for j, nm in enumerate(self.terrain_names):
+            m = ent.terrain_types == j
+            if j != self.flat_col and m.any():
+                out[f"level_{nm}"] = float(lv[m].mean())
+        m = self.on_terrain()
+        if m.any():
+            out["level_mean"] = float(lv[m].mean())
+            out["top_level_share"] = float((lv[m] >= ent.max_terrain_level - 1).float().mean())
+            out["spawn_hover_mean"] = float(self.spawn_hover[m].mean())
+        tot = float(self.level_moves.sum())
+        if tot > 0:
+            out["up_share"] = float(self.level_moves[0]) / tot
+            out["down_share"] = float(self.level_moves[1]) / tot
+        self.level_moves.zero_()
+        out["flat_bins_seen"] = float(self.flat_bin_seen.float().mean())
+        return out
+
+    def terrain_state(self) -> dict:
+        """Curriculum state that has to survive a restart (checkpoint)."""
+        ent = self.terrain_entity
+        return {"levels": ent.terrain_levels.clone(), "types": ent.terrain_types.clone(), "flat_bin_reward": self.flat_bin_reward.clone(), "flat_bin_seen": self.flat_bin_seen.clone()}
+
+    def load_terrain_state(self, sd: dict) -> bool:
+        """Restore ``terrain_state``. Returns False (and changes nothing) when the env layout differs."""
+        ent = self.terrain_entity
+        if sd["levels"].shape != ent.terrain_levels.shape or not torch.equal(sd["types"].to(self.device), ent.terrain_types):
+            return False
+        ent.terrain_levels[:] = sd["levels"].to(self.device)
+        ent.env_origins[:] = ent.terrain_origins[ent.terrain_levels, ent.terrain_types]
+        if sd["flat_bin_reward"].shape == self.flat_bin_reward.shape:
+            self.flat_bin_reward.copy_(sd["flat_bin_reward"])
+            self.flat_bin_seen.copy_(sd["flat_bin_seen"])
+        return True
+
