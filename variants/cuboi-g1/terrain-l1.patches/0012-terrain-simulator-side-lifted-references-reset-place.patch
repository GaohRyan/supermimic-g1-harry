diff --git a/src/supermimic/terrain/lifts.py b/src/supermimic/terrain/lifts.py
new file mode 100644
index 0000000..0ef795f
--- /dev/null
+++ b/src/supermimic/terrain/lifts.py
@@ -0,0 +1,85 @@
+"""How a flat-ground reference is raised onto terrain (docs/plans/terrain-PLAN.md, T2).
+
+One implementation for the three places that need it: the analytic reward of the imagined rollouts, the simulator-side
+command term (reward, termination, reset placement) and the local tools. Everything is plain torch.
+
+Conventions
+  base lift   mean terrain height under the robot: the 0.6 x 0.4 m patch of the height scan around the root.
+              The reference root, the upper body and the termination height are raised by it.
+  body lift   feet: terrain height under the foot's own re-anchored reference position; knees: half-way between
+              that and the base lift; everything else: the base lift.
+  spawn lift  where a reset puts the robot: the base lift, raised further until no sole point is inside the terrain.
+The lifts never carry a gradient.
+"""
+
+from __future__ import annotations
+
+import torch
+
+# Sole of the G1 foot in the ankle-roll link frame (x forward, y left), m. The seven foot collision capsules of the
+# model (radius 0.01, centre lines at z = -0.025) span x in [-0.054, 0.132], y in [-0.027, 0.027]; the sample points
+# cover that footprint including the capsule radius.
+SOLE_X = (-0.064, 0.005, 0.073, 0.142)
+SOLE_Y = (-0.037, 0.0, 0.037)
+SOLE_OFFSET = 0.035  # height of the ankle-roll link origin above the sole
+
+
+def leg_lift_layout(tracked_body_names, device="cpu"):
+    """-> leg_side (B,) long (0 left, 1 right), leg_weight (B,) share of the foot's own terrain height in the lift of
+    each tracked body (feet 1, knees 0.5, others 0), foot_index (2,) tracked-body indices of the left / right foot
+    (None when the feet are not tracked)."""
+    names = list(tracked_body_names)
+    side = torch.zeros(len(names), dtype=torch.long)
+    weight = torch.zeros(len(names))
+    for i, nm in enumerate(names):
+        side[i] = 1 if nm.startswith("right_") else 0
+        weight[i] = 1.0 if "ankle_roll" in nm else (0.5 if "knee" in nm else 0.0)
+    foot = None
+    if "left_ankle_roll_link" in names and "right_ankle_roll_link" in names:
+        foot = torch.tensor([names.index("left_ankle_roll_link"), names.index("right_ankle_roll_link")], dtype=torch.long, device=device)
+    return side.to(device), weight.to(device), foot
+
+
+def base_lift_from_scan(root_z: torch.Tensor, scan: torch.Tensor, patch_index: torch.Tensor) -> torch.Tensor:
+    """root_z (...,), scan (..., P) = root_z - terrain height -> mean terrain height over the patch (...,)."""
+    return (root_z - scan[..., patch_index].mean(-1)).detach()
+
+
+def body_lifts(base_lift: torch.Tensor, ref_body_pos: torch.Tensor, ground_fn, leg_side: torch.Tensor | None, leg_weight: torch.Tensor | None, foot_index: torch.Tensor | None) -> torch.Tensor:
+    """Lift (..., B) of every re-anchored reference body.
+
+    ref_body_pos (..., B, 3): re-anchored reference bodies in the frame ``ground_fn`` expects; ground_fn maps xy
+    (..., K, 2) to terrain height (..., K). leg_side (B,) long, leg_weight (B,), foot_index (2,): see AnalyticHeads.
+    """
+    base_lift = base_lift.detach()
+    lift = base_lift[..., None].expand(ref_body_pos.shape[:-1])
+    if ground_fn is not None and foot_index is not None:
+        g_foot = ground_fn(ref_body_pos[..., foot_index, :2].detach()).detach()  # (..., 2) terrain under the reference feet
+        lift = lift * (1.0 - leg_weight) + g_foot[..., leg_side] * leg_weight
+    return lift
+
+
+def sole_points(foot_pos: torch.Tensor, foot_quat: torch.Tensor) -> torch.Tensor:
+    """World positions (..., F, 12, 3) of the sole sample points of feet with link pose foot_pos (..., F, 3), foot_quat (..., F, 4)."""
+    from supermimic.kinematics.rotations import quat_apply
+
+    xs = torch.as_tensor(SOLE_X, dtype=foot_pos.dtype, device=foot_pos.device)
+    ys = torch.as_tensor(SOLE_Y, dtype=foot_pos.dtype, device=foot_pos.device)
+    local = torch.stack([xs[:, None].expand(-1, len(SOLE_Y)), ys[None, :].expand(len(SOLE_X), -1), torch.full((len(SOLE_X), len(SOLE_Y)), -SOLE_OFFSET, dtype=foot_pos.dtype, device=foot_pos.device)], dim=-1).reshape(-1, 3)
+    k = local.shape[0]
+    q = foot_quat[..., None, :].expand(*foot_quat.shape[:-1], k, 4)
+    return foot_pos[..., None, :] + quat_apply(q, local.expand(*foot_pos.shape[:-1], k, 3))
+
+
+def spawn_lift(base_lift: torch.Tensor, foot_pos: torch.Tensor, foot_quat: torch.Tensor, ground_fn, margin: float = 0.0) -> torch.Tensor:
+    """Height (...,) to add to a flat-ground reference pose so that it can be placed on the terrain.
+
+    foot_pos / foot_quat (..., F, ·): the feet of the flat-ground pose, at the horizontal position where it will be
+    placed. The result is the base lift, raised until every sole point is at least ``margin`` above the terrain.
+    A sole point that is below the floor in the flat-ground reference (retargeting error) counts as on the floor, so
+    that the lift is exactly the base lift (0) on flat ground.
+    """
+    pts = sole_points(foot_pos, foot_quat)  # (..., F, K, 3)
+    flat = pts.reshape(*pts.shape[:-3], -1, 3)
+    need = ground_fn(flat[..., :2]) - flat[..., 2].clamp_min(0.0) + margin  # lift that puts this point on the terrain
+    return torch.maximum(base_lift, need.max(dim=-1).values).detach()
