+"""Terrain lifts, reset placement, origin handling, checkpoint expansion: the pure-torch parts of the terrain task."""
+import types
+
+import pytest
+import torch
+
+pytest.importorskip("mjlab.utils.lab_api.math")
+
+from supermimic.terrain.expand import expand_optimizer_state, load_state_dict_expand  # noqa: E402
+from supermimic.terrain.heightmap import ScanPattern, TerrainMap  # noqa: E402
+from supermimic.terrain.lifts import SOLE_OFFSET, base_lift_from_scan, body_lifts, leg_lift_layout, sole_points, spawn_lift  # noqa: E402
+
+TRACKED = ("pelvis", "left_hip_roll_link", "left_knee_link", "left_ankle_roll_link", "right_hip_roll_link", "right_knee_link", "right_ankle_roll_link",
+           "torso_link", "left_shoulder_roll_link", "left_elbow_link", "left_wrist_yaw_link", "right_shoulder_roll_link", "right_elbow_link", "right_wrist_yaw_link")
+IDENT = torch.tensor([1.0, 0.0, 0.0, 0.0])
+
+
+def step_map(height: float = 0.2) -> TerrainMap:
+    """Ground at 0 for x < 0, a step of ``height`` for x >= 0 (1 cm cells, 4 x 4 m around the origin)."""
+    h = torch.zeros(400, 400)
+    h[:, 200:] = height
+    return TerrainMap(h, -2.0, -2.0, 0.01)
+
+
+def test_leg_layout():
+    side, weight, foot = leg_lift_layout(TRACKED)
+    assert foot.tolist() == [3, 6]
+    assert weight.tolist() == [0, 0, 0.5, 1, 0, 0.5, 1] + [0] * 7
+    assert side[3] == 0 and side[6] == 1 and side[2] == 0 and side[5] == 1
+
+
+def test_patch_is_7_by_5_and_its_mean_is_the_base_lift():
+    pat = ScanPattern.grid()
+    idx = pat.patch_index()
+    assert idx.numel() == 35 and pat.subset(idx).offsets.abs().max() <= 0.3 + 1e-6
+    tm = step_map(0.2)
+    root = torch.tensor([[0.0, 0.0, 0.8], [-1.0, 0.0, 0.75], [1.0, 0.0, 1.0]])
+    scan = tm.scan(root, torch.zeros(3), pat)
+    base = base_lift_from_scan(root[:, 2], scan, idx)
+    # x offsets of the patch: -0.3 .. 0.3 in 0.1 steps; the step starts at x = 0 -> 4 of the 7 columns are on it
+    assert torch.allclose(base, torch.tensor([0.2 * 4 / 7, 0.0, 0.2]), atol=1e-6)
+    # the same number from the patch-only pattern (what the simulator-side command term scans)
+    scan_p = tm.scan(root, torch.zeros(3), pat.subset(idx))
+    assert torch.equal(root[:, 2] - scan_p.mean(-1), base)
+
+
+def test_body_lifts_feet_follow_their_own_terrain():
+    side, weight, foot = leg_lift_layout(TRACKED)
+    tm = step_map(0.2)
+    pos = torch.zeros(1, 14, 3)
+    pos[0, 3, 0], pos[0, 6, 0] = -0.3, 0.3  # left foot before the step, right foot on it
+    lift = body_lifts(torch.tensor([0.1]), pos, tm.height, side, weight, foot)[0]
+    assert lift[3] == 0.0 and lift[6] == pytest.approx(0.2)  # feet: terrain under each foot
+    assert lift[2] == pytest.approx(0.05) and lift[5] == pytest.approx(0.15)  # knees: half-way to the base lift
+    assert torch.allclose(lift[[0, 1, 4, 7, 8, 13]], torch.full((6,), 0.1))  # the rest: base lift
+    # flat ground: every body gets the base lift (0)
+    flat = TerrainMap.flat()
+    assert torch.equal(body_lifts(torch.zeros(1), pos, flat.height, side, weight, foot), torch.zeros(1, 14))
+
+
+def test_spawn_lift():
+    tm = step_map(0.2)
+    quat = IDENT.expand(1, 2, 4)
+    stance = SOLE_OFFSET  # ankle height of a foot standing on the floor
+    # both feet before the step: nothing to add to the base lift
+    feet = torch.tensor([[[-1.0, 0.1, stance], [-1.2, -0.1, stance]]])
+    assert spawn_lift(torch.zeros(1), feet, quat, tm.height).item() == 0.0
+    # one foot over the step: the pose is raised by the riser, however small the base lift is
+    feet = torch.tensor([[[0.3, 0.1, stance], [-0.3, -0.1, stance]]])
+    assert spawn_lift(torch.tensor([0.1]), feet, quat, tm.height).item() == pytest.approx(0.2, abs=1e-6)
+    # the toe reaches over the edge although the ankle is before it (sole spans x in [-0.064, 0.142])
+    feet = torch.tensor([[[-0.10, 0.1, stance], [-0.6, -0.1, stance]]])
+    assert spawn_lift(torch.zeros(1), feet, quat, tm.height).item() == pytest.approx(0.2, abs=1e-6)
+    # a swing foot 15 cm up over the step needs 5 cm only
+    feet = torch.tensor([[[0.3, 0.1, stance + 0.15], [-0.6, -0.1, stance]]])
+    assert spawn_lift(torch.zeros(1), feet, quat, tm.height).item() == pytest.approx(0.05, abs=1e-6)
+    # flat ground: exactly the base lift, also when the flat-ground reference dips below the floor
+    feet = torch.tensor([[[0.3, 0.1, stance - 0.02], [-0.6, -0.1, stance]]])
+    assert spawn_lift(torch.zeros(1), feet, quat, TerrainMap.flat().height).item() == 0.0
+    # sole geometry
+    pts = sole_points(torch.zeros(1, 1, 3), IDENT.expand(1, 1, 4))
+    assert pts.shape == (1, 1, 12, 3) and torch.allclose(pts[..., 2], torch.full((1, 1, 12), -SOLE_OFFSET))
+    assert pts[..., 0].min() == pytest.approx(-0.064) and pts[..., 0].max() == pytest.approx(0.142)
+
+
+def test_state_origin_and_actor_scan():
+    from supermimic.envs.state_io import state_origin
+    from supermimic.terrain.actor_scan import ActorScan
+
+    n = 3
+    origins = torch.tensor([[5.0, 1.0, 0.0], [-3.0, 2.0, 4.0], [0.0, 0.0, -2.0]])
+    qpos = torch.zeros(n, 36)
+    qpos[:, 3] = 1.0
+    qpos[:, 2] = torch.tensor([0.8, 4.8, -1.2])  # world heights
+    qpos[:, :2] = origins[:, :2]
+
+    def make(terrain):
+        scene = types.SimpleNamespace(env_origins=origins, terrain=terrain)
+        sim = types.SimpleNamespace(data=types.SimpleNamespace(qpos=qpos, qvel=torch.zeros(n, 35)))
+        return types.SimpleNamespace(scene=scene, sim=sim, device="cpu", num_envs=n)
+
+    plane = make(types.SimpleNamespace(terrain_origins=None))
+    assert state_origin(plane) is origins  # flat task: the scene origins, untouched
+    gen = make(types.SimpleNamespace(terrain_origins=torch.zeros(2, 2, 3)))
+    o = state_origin(gen)
+    assert torch.equal(o[:, :2], origins[:, :2]) and torch.equal(o[:, 2], torch.zeros(n)) and origins[1, 2] == 4.0  # copy, z = 0
+    # scan of the simulator state on flat ground = root height at every point; the state keeps its world height
+    scan = ActorScan(gen, None)()
+    assert scan.shape == (n, 187) and torch.allclose(scan, qpos[:, 2:3].expand(n, 187))
+    # on a map: height above the terrain under each point
+    tm = TerrainMap(torch.full((40, 40), 4.0), -10.0, -10.0, 0.5)
+    assert torch.allclose(ActorScan(gen, tm).clean()[1], torch.full((187,), 0.8), atol=1e-6)
+    noisy = ActorScan(gen, tm, noise=0.03)()
+    assert (noisy - ActorScan(gen, tm).clean()).abs().max() <= 0.03 + 1e-6
+
+
+def test_expanded_checkpoint_and_optimizer_state():
+    torch.manual_seed(0)
+    old = torch.nn.Sequential(torch.nn.Linear(6, 16), torch.nn.ELU(), torch.nn.Linear(16, 3))
+    opt = torch.optim.AdamW(old.parameters(), lr=1e-3, weight_decay=0.0)
+    x = torch.randn(32, 6)
+    for _ in range(5):
+        opt.zero_grad()
+        old(x).pow(2).mean().backward()
+        opt.step()
+    new = torch.nn.Sequential(torch.nn.Linear(10, 16), torch.nn.ELU(), torch.nn.Linear(16, 3))
+    rep = load_state_dict_expand(new, old.state_dict())
+    assert rep["expanded"] == {"0.weight": (6, 10)}
+    extra = torch.randn(32, 4)
+    assert torch.equal(new(torch.cat([x, extra], -1)), old(x))  # new inputs have no effect yet
+    sd = expand_optimizer_state(opt.state_dict(), list(new.parameters()))
+    opt2 = torch.optim.AdamW(new.parameters(), lr=1e-3, weight_decay=0.0)
+    opt2.load_state_dict(sd)
+    st_old, st_new = opt.state[next(iter(old.parameters()))], opt2.state[next(iter(new.parameters()))]
+    assert torch.equal(st_new["exp_avg"][:, :6], st_old["exp_avg"]) and torch.equal(st_new["exp_avg"][:, 6:], torch.zeros(16, 4))
+    assert torch.equal(st_new["exp_avg_sq"][:, :6], st_old["exp_avg_sq"])
+    # one more step on the same data moves the old columns exactly as the old network would have moved
+    for o, net, inp in ((opt, old, x), (opt2, new, torch.cat([x, torch.zeros(32, 4)], -1))):
+        o.zero_grad()
+        net(inp).pow(2).mean().backward()
+        o.step()
+    assert torch.allclose(new[0].weight[:, :6], old[0].weight, atol=1e-7) and torch.allclose(new[2].weight, old[2].weight, atol=1e-7)
+    # a layout that does not match is refused
+    other = torch.nn.Sequential(torch.nn.Linear(10, 8), torch.nn.ELU(), torch.nn.Linear(8, 3))
+    assert expand_optimizer_state(opt.state_dict(), list(other.parameters())) is None
