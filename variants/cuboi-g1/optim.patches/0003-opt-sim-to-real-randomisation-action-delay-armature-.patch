diff --git a/src/supermimic/envs/sim2real_dr.py b/src/supermimic/envs/sim2real_dr.py
new file mode 100644
index 0000000..ae13fef
--- /dev/null
+++ b/src/supermimic/envs/sim2real_dr.py
@@ -0,0 +1,81 @@
+"""Extra dynamics randomisation for sim-to-real (optimisation line; not in the paper or the official release).
+
+Per environment, five scalars (kept on ``env.sm_dr`` so the world-model context xi can carry them):
+  0 armature scale      (startup; needs set_const_0)   reflected rotor inertia of every robot dof
+  1 kp scale            (reset)                        actuator stiffness
+  2 kd scale            (reset)                        actuator damping
+  3 joint damping u     (reset) in [0, 1]              passive damping  = u * damping_per_armature * armature_nominal
+  4 friction loss u     (reset) in [0, 1]              dry friction     = u * frictionloss_per_armature * armature_nominal
+The G1 model has zero nominal passive damping / friction loss, so those two are absolute and sized by the joint's armature
+(bigger motor, more loss). Nominal = [1, 1, 1, 0, 0].
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+from mjlab.managers.event_manager import RecomputeLevel, requires_model_fields
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+
+SM_DR_DIM = 5
+SM_DR_NOMINAL = (1.0, 1.0, 1.0, 0.0, 0.0)
+# xi normalisation (offset, scale) for the five scalars with the default ranges below.
+SM_DR_XI_OFFSET = (1.1, 1.0, 1.0, 0.5, 0.5)
+SM_DR_XI_SCALE = (0.4, 0.15, 0.15, 0.5, 0.5)
+
+
+def get_sm_dr(env) -> torch.Tensor:
+    if not hasattr(env, "sm_dr"):
+        env.sm_dr = torch.tensor(SM_DR_NOMINAL, device=env.device).repeat(env.num_envs, 1)
+    return env.sm_dr
+
+
+def _ids(env, env_ids):
+    if env_ids is None:
+        return torch.arange(env.num_envs, device=env.device, dtype=torch.long)
+    return env_ids.to(env.device, dtype=torch.long)
+
+
+def _uniform(n, lo, hi, device):
+    return lo + (hi - lo) * torch.rand(n, device=device)
+
+
+@requires_model_fields("dof_armature", recompute=RecomputeLevel.set_const_0)
+def armature_scale(env: ManagerBasedRlEnv, env_ids, scale_range: tuple[float, float] = (0.7, 1.5), entity_name: str = "robot") -> None:
+    ids = _ids(env, env_ids)
+    v_adr = env.scene[entity_name].indexing.joint_v_adr
+    s = _uniform(len(ids), *scale_range, env.device)
+    default = env.sim.get_default_field("dof_armature")
+    env.sim.model.dof_armature[ids[:, None], v_adr] = default[v_adr][None, :] * s[:, None]
+    get_sm_dr(env)[ids, 0] = s
+
+
+@requires_model_fields("dof_damping", "dof_frictionloss", "actuator_gainprm", "actuator_biasprm")
+def joint_actuator_dr(
+    env: ManagerBasedRlEnv,
+    env_ids,
+    kp_range: tuple[float, float] = (0.85, 1.15),
+    kd_range: tuple[float, float] = (0.85, 1.15),
+    damping_per_armature: float = 10.0,
+    frictionloss_per_armature: float = 20.0,
+    entity_name: str = "robot",
+) -> None:
+    ids = _ids(env, env_ids)
+    n = len(ids)
+    ent = env.scene[entity_name]
+    v_adr, ctrl = ent.indexing.joint_v_adr, ent.indexing.ctrl_ids
+    kp, kd = _uniform(n, *kp_range, env.device), _uniform(n, *kd_range, env.device)
+    ud, uf = torch.rand(n, device=env.device), torch.rand(n, device=env.device)
+    gain0, bias0 = env.sim.get_default_field("actuator_gainprm"), env.sim.get_default_field("actuator_biasprm")
+    arm0 = env.sim.get_default_field("dof_armature")[v_adr]
+    m = env.sim.model
+    m.actuator_gainprm[ids[:, None], ctrl, 0] = gain0[ctrl, 0][None, :] * kp[:, None]
+    m.actuator_biasprm[ids[:, None], ctrl, 1] = bias0[ctrl, 1][None, :] * kp[:, None]
+    m.actuator_biasprm[ids[:, None], ctrl, 2] = bias0[ctrl, 2][None, :] * kd[:, None]
+    m.dof_damping[ids[:, None], v_adr] = damping_per_armature * arm0[None, :] * ud[:, None]
+    m.dof_frictionloss[ids[:, None], v_adr] = frictionloss_per_armature * arm0[None, :] * uf[:, None]
+    dr = get_sm_dr(env)
+    dr[ids, 1], dr[ids, 2], dr[ids, 3], dr[ids, 4] = kp, kd, ud, uf
